+      ['--focus', P.field], ['--danger', P.danger], ['--success', P.success],
+    ],
+    dark: [
+      ['--bg', P.ink], ['--surface', '#262742'], ['--fg', P.paper], ['--muted', '#b6b2c4'],
+      ['--border', P.paper], ['--accent', P.core], ['--accent-ink', onField(P.core)],
+      ['--focus', P.core], ['--danger', '#ff8a80'], ['--success', '#6fdc9f'],
+    ],
+  },
+  components: {
