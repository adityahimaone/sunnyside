+const ratio = (a, b) => {
+  const x = lum(a)
+  const y = lum(b)
+  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05)
+}
+// Pick the readable one of two inks on a field.
+const onField = (bg) => (ratio(P.ink, bg) >= ratio(P.paperHi, bg) ? P.ink : P.paperHi)
