+const tokensRaw = {
+  primitives: Object.entries(P).map(([k, v]) => ({ name: `--${slug}-${k.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase())}`, value: v })),
+  semantic: {
+    light: [
+      ['--bg', P.paper], ['--surface', P.paperHi], ['--fg', P.ink], ['--muted', P.muted],
