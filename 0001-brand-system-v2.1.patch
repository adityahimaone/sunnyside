+      `<path d="${rays.join('')}" fill="none" stroke="${c.ink}" stroke-width="${w}" stroke-linecap="round"/>` +
+      `</g>` +
+      `<circle cx="${cx}" cy="${cy}" r="${sun}" fill="${c.core}" stroke="${c.ink}" stroke-width="${compact ? 3 : dna.stroke}"/>` +
+      eyes
