+  if (/<text[\s>]/.test(content)) problems.push(`${file}: live <text>`)
+  if (!/viewBox=/.test(content)) problems.push(`${file}: no viewBox`)
+  if (!/<(path|circle|rect)/.test(content)) problems.push(`${file}: empty drawing`)
