+      `<g clip-path="url(#${clipId})"><path d="${lines.join('')}" fill="none" stroke="${c.ink}" stroke-width="${w}"/></g>` +
+      `<circle cx="32" cy="32" r="${orb}" fill="${c.core}" stroke="${c.ink}" stroke-width="${compact ? 3 : 2.4}"/>`
+    )
+  },
+  stack(c, compact) {
