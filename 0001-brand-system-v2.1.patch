+    try {
+      const source = await readFile(join(dir, `${name}.svg`), 'utf8')
+      boxes.set(name, source.match(/viewBox\s*=\s*["']([^"']+)["']/)?.[1])
+      counts[name] = (source.match(/<(path|circle|rect|ellipse|polygon|line)[\s>]/g) || []).length
+    } catch {
