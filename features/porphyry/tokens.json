{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Porphyry",
    "version": "1.0.0",
    "updated": "2026-10-31",
    "caseNumber": "Case 10",
    "essence": "Porphyry, marble, gold leaf and one dark stage.",
    "promise": "A classical stage for modern interfaces: one stone, one light, a cast that stands in front of the word.",
    "oneSentence": "A page composed like a stage: one stone, one light, and a cast that stands in front of the word.",
    "idea": "The screen is a diorama, not a document. The wordmark fills with marble; the figures are keyed off their own ground; the light does the depth.",
    "track": "constructed",
    "family": "architectural block",
    "material": "porphyry + marble + gold leaf + one dark stage",
    "namespace": "--po-",
    "markForm": "stone block, gold threshold",
    "note": "Mirrors features/porphyry/porphyry-tokens.css. Mark geometry is in public/brand/porphyry/*.svg on the 64 grid; the wordmark is outlined from Cinzel, never live text.",
    "sections": [
      "stage",
      "story",
      "cast",
      "mark",
      "stone",
      "type",
      "parts",
      "tokens",
      "audit"
    ]
  },
  "theme": {
    "family": "architectural block",
    "material": "porphyry + marble + gold leaf + one dark stage",
    "edge": "0 radius, 1px engraved rule",
    "offset": "none — depth comes from light, never misregistration",
    "stroke": "0 (fill only)",
    "tile": "none",
    "radius": "0",
    "ring": "2px gold, 2px offset",
    "density": "airy",
    "label": "caps, 0.22em, Jost 500",
    "field-recipe": "inscribed-slab",
    "mark-form": "stone block, gold threshold"
  },
  "primitives": [
