{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Tactile Glass & Crisp Grid · Indigo Harbor",
  "version": "1.1.0",
  "description": "Dashboard design system on shadcn/ui. One glass surface, one hairline grid, one signal colour. The material is harbor water: every neutral carries chroma toward hue 267 at the lightness a zinc step would have had.",
  "material": {
    "idea": "Harbor water at dusk: cool paper, indigo signal, one deep navy pole.",
    "paper": "#f3f5fb",
    "harbor": "#19398d",
    "water": "#001b3c",
    "night": "#6a8dd8"
  },
  "radius": {
    "base": "0.75rem",
    "sm": "calc(0.75rem - 4px)",
    "md": "calc(0.75rem - 2px)",
    "lg": "0.75rem",
    "xl": "calc(0.75rem + 4px)",
    "2xl": "calc(0.75rem + 12px)"
  },
  "primitive": {
    "lg-harbor-000": { "value": "oklch(1 0 0)", "hex": "#ffffff" },
    "lg-harbor-025": { "value": "oklch(0.988 0.004 271.4)", "hex": "#fafbfe" },
    "lg-harbor-050": { "value": "oklch(0.970 0.008 271.3)", "hex": "#f3f5fb" },
    "lg-harbor-100": { "value": "oklch(0.955 0.011 269.5)", "hex": "#edf0f8" },
    "lg-harbor-150": { "value": "oklch(0.940 0.015 270.0)", "hex": "#e7ebf6" },
    "lg-harbor-200": { "value": "oklch(0.912 0.020 267.3)", "hex": "#dce2f0" },
    "lg-harbor-300": { "value": "oklch(0.844 0.030 266.3)", "hex": "#c3cce0" },
    "lg-harbor-400": { "value": "oklch(0.716 0.044 267.5)", "hex": "#97a3c0" },
    "lg-harbor-500": { "value": "oklch(0.527 0.060 267.9)", "hex": "#5c6a8e" },
    "lg-harbor-600": { "value": "oklch(0.451 0.065 269.2)", "hex": "#47547a" },
    "lg-harbor-700": { "value": "oklch(0.382 0.074 270.5)", "hex": "#34406a" },
    "lg-harbor-800": { "value": "oklch(0.295 0.067 269.2)", "hex": "#1f2a4e" },
    "lg-harbor-900": { "value": "oklch(0.180 0.042 269.3)", "hex": "#0a1024" },
    "lg-harbor-950": { "value": "oklch(0.144 0.024 260.2)", "hex": "#050a14" },
    "lg-harbor-deep": { "value": "oklch(0.224 0.072 254.3)", "hex": "#001b3c" },
    "lg-indigo-100": { "value": "oklch(0.934 0.026 268.8)", "hex": "#e2e9fb" },
    "lg-indigo-200": { "value": "oklch(0.834 0.056 268.2)", "hex": "#b9c8ee" },
    "lg-indigo-300": { "value": "oklch(0.751 0.087 264.5)", "hex": "#93aee6" },
    "lg-indigo-400": { "value": "oklch(0.650 0.119 264.3)", "hex": "#6a8dd8" },
    "lg-indigo-500": { "value": "oklch(0.508 0.146 265.7)", "hex": "#3d5fb8" },
    "lg-indigo-600": { "value": "oklch(0.378 0.145 264.5)", "hex": "#19398d" },
    "lg-indigo-700": { "value": "oklch(0.329 0.123 264.7)", "hex": "#142e73" },
    "lg-indigo-ring": { "value": "oklch(0.447 0.127 265.6)", "hex": "#324f9a" },
    "lg-teal-500": { "value": "oklch(0.621 0.107 184.3)", "hex": "#119b8e" },
    "lg-teal-400": { "value": "oklch(0.695 0.111 185.1)", "hex": "#2fb3a6" },
    "lg-crimson-600": { "value": "oklch(0.439 0.175 14.2)", "hex": "#9b0033" }
  },
  "ramp": [
    { "token": "--lg-harbor-050", "l": "0.970", "role": "App background" },
    { "token": "--lg-harbor-100", "l": "0.955", "role": "Recess / rail" },
    { "token": "--lg-harbor-150", "l": "0.940", "role": "Muted fill" },
    { "token": "--lg-harbor-200", "l": "0.912", "role": "Hairline" },
    { "token": "--lg-harbor-300", "l": "0.844", "role": "Disabled ink" },
    { "token": "--lg-harbor-400", "l": "0.716", "role": "Ring on night" },
    { "token": "--lg-harbor-500", "l": "0.527", "role": "Second ink" },
    { "token": "--lg-harbor-700", "l": "0.382", "role": "Body ink" },
    { "token": "--lg-harbor-900", "l": "0.180", "role": "Primary ink" },
    { "token": "--lg-harbor-950", "l": "0.144", "role": "Deep surface" }
  ],
  "signal": {
    "name": "Harbor indigo",
    "steps": [
      { "token": "--lg-indigo-100", "l": "0.934", "role": "Wash" },
      { "token": "--lg-indigo-200", "l": "0.834", "role": "Chart 4" },
      { "token": "--lg-indigo-300", "l": "0.751", "role": "Signal ink (night)" },
      { "token": "--lg-indigo-400", "l": "0.650", "role": "Primary (night)" },
      { "token": "--lg-indigo-500", "l": "0.508", "role": "Chart 2" },
      { "token": "--lg-indigo-600", "l": "0.378", "role": "Primary · signal" },
      { "token": "--lg-indigo-700", "l": "0.329", "role": "Signal ink" }
    ],
    "water": { "token": "--lg-harbor-deep", "role": "Mark plate · float shadow" },
    "remainder": { "token": "--lg-teal-500", "role": "Chart 5 · the remainder slice only" },
    "error": { "token": "--lg-crimson-600", "role": "Destructive only" }
  },
  "roles": [
    { "token": "--background", "job": "the canvas", "from": "--lg-harbor-050" },
    { "token": "--card", "job": "the glass", "from": "--lg-harbor-000" },
    { "token": "--foreground", "job": "the ink", "from": "--lg-harbor-900" },
    { "token": "--muted-foreground", "job": "second ink", "from": "--lg-harbor-500" },
    { "token": "--border", "job": "the hairline", "from": "--lg-harbor-200" },
    { "token": "--primary", "job": "the action", "from": "--lg-indigo-600" },
    { "token": "--signal", "job": "state only", "from": "--lg-indigo-600" }
  ],
  "semantic": {
    "light": {
      "background": "var(--lg-harbor-050)",
      "foreground": "var(--lg-harbor-900)",
      "card": "var(--lg-harbor-000)",
      "card-foreground": "var(--lg-harbor-900)",
      "popover": "var(--lg-harbor-025)",
      "primary": "var(--lg-indigo-600)",
      "primary-foreground": "var(--lg-harbor-050)",
      "secondary": "var(--lg-harbor-150)",
      "muted": "var(--lg-harbor-150)",
      "muted-foreground": "var(--lg-harbor-500)",
      "accent": "var(--lg-harbor-150)",
      "border": "var(--lg-harbor-200)",
      "ring": "var(--lg-indigo-ring)",
      "signal": "var(--lg-indigo-600)",
      "signal-ink": "var(--lg-indigo-700)"
    },
    "dark": {
      "background": "oklch(0.150 0.026 263.1)",
      "foreground": "oklch(0.955 0.011 269.5)",
      "card": "oklch(0.186 0.038 266.6)",
      "card-foreground": "oklch(0.955 0.011 269.5)",
      "popover": "oklch(0.222 0.045 266.0)",
      "primary": "var(--lg-indigo-400)",
      "primary-foreground": "oklch(0.150 0.026 263.1)",
      "secondary": "oklch(0.269 0.053 266.2)",
      "muted": "oklch(0.269 0.053 266.2)",
      "muted-foreground": "oklch(0.746 0.043 264.3)",
      "accent": "oklch(0.310 0.059 265.8)",
      "border": "oklch(1 0 0 / 10%)",
      "ring": "var(--lg-indigo-400)",
      "signal": "var(--lg-indigo-400)",
      "signal-ink": "var(--lg-indigo-300)"
    }
  },
  "chart": {
    "note": "Four indigo steps, then one teal. The teal is the remainder slice ('Others') — a remainder is not a category and must not compete for the same hue.",
    "light": ["#142e73", "#3d5fb8", "#6a8dd8", "#b9c8ee", "#119b8e"],
    "dark": ["#b9c8ee", "#93aee6", "#6a8dd8", "#3d5fb8", "#2fb3a6"]
  },
  "contrast": {
    "method": "OKLCh → sRGB → WCAG, measured on the composited panel (65% card over canvas)",
    "light": {
      "foreground on canvas": "17.29:1",
      "foreground on panel": "18.30:1",
      "muted on canvas": "4.93:1",
      "muted on panel": "5.22:1",
      "signal ink on wash": "10.56:1",
      "primary on card": "10.44:1"
    },
    "dark": {
      "foreground on canvas": "17.26:1",
      "foreground on panel": "16.69:1",
      "muted on canvas": "8.71:1",
      "muted on panel": "8.42:1",
      "signal ink on wash": "7.01:1",
      "primary on card": "5.70:1"
    },
    "failing": {
      "pair": "chart-4 #b9c8ee on panel",
      "ratio": "1.93:1",
      "why": "It is a fill, not ink. It is only legible as the fourth step of an ordered ramp, never as a standalone colour, and never behind a number."
    }
  },
  "surface": {
    "panel": {
      "background": "color-mix(in oklab, var(--card) 65%, transparent)",
      "blur": "24px",
      "border": "rgb(0 0 0 / 0.06)",
      "border-dark": "rgb(255 255 255 / 0.08)",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.15)"
    },
    "float": {
      "background": "color-mix(in oklab, var(--popover) 82%, transparent)",
      "blur": "24px",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.18), 0 18px 40px -24px color-mix(in oklab, var(--deep) 55%, transparent)"
    },
    "field": {
      "background": "var(--foreground) at 2%",
      "border": "var(--input)",
      "inner-shadow": "inset 0 1px 2px 0 rgb(0 0 0 / 0.04)",
      "focus-ring": "3px at 15% ink + border at 60%",
      "height": "36px"
    }
  },
  "type": {
    "family": { "sans": "Geist Sans", "mono": "Geist Mono" },
    "scale": {
      "display": { "size": "30px", "line": "1", "tracking": "-0.025em", "weight": 600 },
      "title": { "size": "18px", "line": "1.2", "tracking": "-0.02em", "weight": 600 },
      "body": { "size": "14px", "line": "1.5", "tracking": "0" },
      "small": { "size": "13px", "line": "1.45", "tracking": "0" },
      "micro": { "size": "10px", "line": "1.4", "tracking": "0.14em", "case": "uppercase", "family": "mono" },
      "figure": { "size": "26px", "line": "1", "tracking": "-0.01em", "features": "tabular-nums" }
    }
  },
  "motion": {
    "hover": "200ms",
    "field": "200ms",
    "sidebar": "200ms linear",
    "reduced": "0.01ms"
  },
  "field": {
    "shader": "Mesh drift",
    "colors": ["#060b16", "#9fb4ea", "#4a6bc0", "#2b4fa8", "#19398d"],
    "blend": "OKLab",
    "uniforms": {
      "u_shape": [1.26, 0.35, 0.28, 0.0],
      "u_surface": [1.82, 1.37, -0.02, 0.68],
      "u_finish": [0.0, 0.54, 0.0, 0.22],
      "u_transform": [1.0, 0.0, 0.06, 1.0],
      "u_space": [-0.05, 0.0, 0.0, 0.0],
      "u_cursor": [0.0, 4.0, 0.5, 0.8]
    }
  }
}
