{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Tactile Glass & Crisp Grid",
  "version": "1.0.0",
  "description": "Dashboard design system on shadcn/ui. One glass surface, one hairline grid, one signal colour.",
  "radius": {
    "base": "0.75rem",
    "sm": "calc(0.75rem - 4px)",
    "md": "calc(0.75rem - 2px)",
    "lg": "0.75rem",
    "xl": "calc(0.75rem + 4px)",
    "2xl": "calc(0.75rem + 12px)"
  },
  "primitive": {
    "zinc-000": "oklch(1 0 0)",
    "zinc-025": "oklch(0.991 0.001 260)",
    "zinc-050": "oklch(0.977 0.003 260)",
    "zinc-100": "oklch(0.962 0.004 258)",
    "zinc-150": "oklch(0.944 0.005 260)",
    "zinc-200": "oklch(0.885 0.006 264)",
    "zinc-300": "oklch(0.812 0.007 264)",
    "zinc-400": "oklch(0.705 0.008 264)",
    "zinc-500": "oklch(0.532 0.011 264)",
    "zinc-600": "oklch(0.442 0.010 264)",
    "zinc-700": "oklch(0.372 0.008 264)",
    "zinc-800": "oklch(0.272 0.007 264)",
    "zinc-850": "oklch(0.225 0.006 265)",
    "zinc-900": "oklch(0.205 0.006 285.9)",
    "zinc-950": "oklch(0.145 0.006 265)",
    "signal-500": "oklch(0.548 0.216 262.4)"
  },
  "semantic": {
    "light": {
      "background": "var(--zinc-100)",
      "foreground": "var(--zinc-900)",
      "card": "var(--zinc-000)",
      "popover": "var(--zinc-025)",
      "primary": "var(--zinc-900)",
      "primary-foreground": "var(--zinc-050)",
      "secondary": "var(--zinc-150)",
      "muted": "var(--zinc-150)",
      "muted-foreground": "var(--zinc-500)",
      "border": "var(--zinc-200)",
      "ring": "var(--zinc-500)",
      "signal": "var(--signal-500)",
      "signal-ink": "oklch(0.472 0.19 262)"
    },
    "dark": {
      "background": "oklch(0.155 0.006 265)",
      "foreground": "var(--zinc-100)",
      "card": "oklch(0.215 0.006 265)",
      "popover": "oklch(0.195 0.006 265)",
      "primary": "var(--zinc-100)",
      "primary-foreground": "var(--zinc-900)",
      "secondary": "oklch(0.262 0.007 265)",
      "muted": "oklch(0.262 0.007 265)",
      "muted-foreground": "oklch(0.702 0.009 264)",
      "border": "oklch(1 0 0 / 10%)",
      "ring": "var(--zinc-400)",
      "signal": "var(--signal-500)",
      "signal-ink": "oklch(0.74 0.15 262)"
    }
  },
  "chart": {
    "light": ["oklch(0.272 0.007 264)", "oklch(0.442 0.010 264)", "oklch(0.612 0.009 264)", "oklch(0.762 0.008 264)", "oklch(0.885 0.006 264)"],
    "dark": ["oklch(0.962 0.004 258)", "oklch(0.802 0.007 264)", "oklch(0.632 0.009 264)", "oklch(0.472 0.008 264)", "oklch(0.342 0.007 264)"]
  },
  "surface": {
    "panel": {
      "background": "color-mix(in oklab, var(--card) 65%, transparent)",
      "blur": "24px",
      "border": "rgb(0 0 0 / 0.06)",
      "border-dark": "rgb(255 255 255 / 0.08)",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.15)"
    },
    "float": {
      "background": "color-mix(in oklab, var(--popover) 82%, transparent)",
      "blur": "24px",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.18), 0 18px 40px -24px rgb(9 9 11 / 0.35)"
    },
    "field": {
      "background": "var(--foreground) at 2%",
      "border": "var(--input)",
      "inner-shadow": "inset 0 1px 2px 0 rgb(0 0 0 / 0.04)",
      "focus-ring": "3px at 15% ink + border at 60%",
      "height": "36px"
    }
  },
  "type": {
    "family": { "sans": "Geist Sans", "mono": "Geist Mono" },
    "scale": {
      "display": { "size": "30px", "line": "1", "tracking": "-0.025em", "weight": 600 },
      "title": { "size": "18px", "line": "1.2", "tracking": "-0.02em", "weight": 600 },
      "body": { "size": "14px", "line": "1.5", "tracking": "0" },
      "small": { "size": "13px", "line": "1.45", "tracking": "0" },
      "micro": { "size": "10px", "line": "1.4", "tracking": "0.14em", "case": "uppercase", "family": "mono" },
      "figure": { "size": "26px", "line": "1", "tracking": "-0.01em", "features": "tabular-nums" }
    }
  },
  "motion": {
    "hover": "200ms",
    "field": "200ms",
    "sidebar": "200ms linear",
    "reduced": "0.01ms"
  },
  "field": {
    "shader": "Mesh drift",
    "colors": ["#171717", "#91C5FF", "#3A81F6", "#2563EF", "#1A4EDA"],
    "blend": "OKLab",
    "uniforms": {
      "u_shape": [1.26, 0.35, 0.28, 0.0],
      "u_surface": [1.82, 1.37, -0.02, 0.68],
      "u_finish": [0.0, 0.54, 0.0, 0.22],
      "u_transform": [1.0, 0.0, 0.06, 1.0],
      "u_space": [-0.05, 0.0, 0.0, 0.0],
      "u_cursor": [0.0, 4.0, 0.5, 0.8]
    }
  }
}
