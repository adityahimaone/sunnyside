    "namespace": "--st-",
    "essence": "Two planes, and the strand between them.",
    "promise": "Quiet glass over dune light, one sun-warm signal.",
    "family": "Offset geometric planes",
    "track": "constructed",
    "gate": "v3.0 constructed",
    "oneSentence": "Strand is a coastal interface system for reading in daylight: every surface is a pane of sea-glass over dune light, the ink is the colour of deep water, and one sun-warm signal marks the place where something happens.",
    "fieldImage": "/brand/strand/dune-quiet-divider.webp",
    "sections": [
      "foundation",
      "glass",
      "marks",
      "horizon",
      "palette",
      "type",
      "parts",
      "motion",
      "voice",
      "tokens",
      "audit"
    ],
    "detach": "Measured against Cove, Clearing, Hachure, Riso and Vitrine; the weakest pair decides.",
    "material": "sea-glass",
    "glass": "One pane per view: 24px blur, 158deg white gradient, a 1px specular top edge, a long low shadow. Copy sits on a solid plate inside it."
  },
