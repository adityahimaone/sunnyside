  "dither": { "matrix": "bayer-4x4", "rows": 22, "cells": 484 },
  "motion": { "fast": 140, "ui": 220, "slow": 420, "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)" },
  "type": { "display": "Bodoni Moda 400/500", "reading": "Geist 400", "mono": "Geist Mono 400/500" }
