@@ -0,0 +1,334 @@
+/* ============================================================================
+ * OpenPencil runtime — headless canvas builder.
+ *
+ * Generated by scripts/figma-forge.mjs, run by
+ *   openpencil eval <file>.fig -w --stdin < openpencil.build.js
+ *
+ * Two modes, chosen by DATA.mode:
+ *   polish  — the document was produced by `openpencil import <design-system.html>`;
+ *             this renames the imported sections, adds a cover, a tokens page and
+ *             a marks page made of real vectors.
+ *   board   — no HTML exists; the whole board is built from tokens.
+ *
+ * Synchronous on purpose: the headless runtime has no style or variable API, and
+ * an async IIFE makes the CLI print a promise instead of the summary.
+ * ==========================================================================*/
+
+const DATA = __DATA__;
+
+const report = { mode: DATA.mode, pages: [], errors: [], counts: {} };
+const fail = (where, e) => report.errors.push(where + ': ' + ((e && e.message) || String(e)));
+
+const hexToRgb = (hex) => {
+  let h = String(hex || '').trim().replace('#', '');
+  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
+  if (h.length === 8) h = h.slice(0, 6);
+  const n = parseInt(h, 16);
+  if (Number.isNaN(n)) return { r: 0, g: 0, b: 0 };
+  return { r: ((n >> 16) & 255) / 255, g: ((n >> 8) & 255) / 255, b: (n & 255) / 255 };
+};
+const solid = (hex, a) => ({ type: 'SOLID', color: hexToRgb(hex), opacity: a == null ? 1 : a });
+
+const paper = DATA.colours.paper || '#FFFFFF';
+const ink = DATA.colours.ink || '#111111';
+const muted = DATA.colours.inkMuted || ink;
+const raised = DATA.colours.raised || paper;
+const accent = DATA.colours.accent || ink;
+
+function mkFrame(parent, name, x, y, w, h, fill) {
+  const f = figma.createFrame();
+  f.name = name;
+  f.x = x;
+  f.y = y;
+  f.resize(w, h);
+  f.fills = fill ? [solid(fill)] : [];
+  if (parent) parent.appendChild(f);
+  return f;
+}
+
+function mkText(parent, content, x, y, size, colour, weight, family) {
+  const t = figma.createText();
+  t.characters = String(content);
+  t.fontSize = size;
+  t.fills = [solid(colour || ink)];
+  t.x = x;
+  t.y = y;
+  /* The headless rasterizer draws only the families it bundles; setting any
+   * other family produces a node that is correct in the file and blank in a PNG
+   * proof. The forge resolves DATA.figFont to a family that renders. */
+  try {
+    t.fontName = { family: family || DATA.figFont, style: weight || 'Regular' };
+  } catch (e) {
+    /* leave the default face */
+  }
+  if (parent) parent.appendChild(t);
+  return t;
+}
+
+function mkRect(parent, name, x, y, w, h, fill, radius) {
+  const r = figma.createRectangle();
+  r.name = name;
+  r.x = x;
+  r.y = y;
+  r.resize(w, h);
+  r.fills = fill ? [solid(fill)] : [];
+  if (radius) r.cornerRadius = radius;
+  /* A cream swatch on a cream sheet has no edge at 1×; clearing ships one, and
+   * without a hairline the strip reads as a gap rather than a colour. */
+  try {
+    r.strokes = [solid(muted, 0.3)];
+    r.strokeWeight = 1;
+  } catch (e) {
+    /* stroke unsupported */
+  }
+  if (parent) parent.appendChild(r);
+  return r;
+}
+
+/* ── cover ──────────────────────────────────────────────────────────────── */
+
+function buildCover() {
+  const page = figma.createPage();
+  page.name = '00 · Cover';
+  try {
+    figma.root.insertChild(0, page);
+  } catch (e) {
+    /* ordering is cosmetic; the name is what matters */
+  }
+  figma.currentPage = page;
+  const W = 1600;
+  const H = 1000;
+  const f = mkFrame(page, 'Cover', 0, 0, W, H, paper);
+
+  mkText(f, DATA.name, 96, 110, 120, ink, 'Bold');
+  if (DATA.essence) mkText(f, DATA.essence, 96, 268, 24, muted);
+  mkText(f, DATA.meta || '', 96, 330, 14, muted);
+
+  /* the mark is the one thing on the cover that is not type */
+  const mark = (DATA.assets || []).find((a) => a.name === 'mark') || (DATA.assets || [])[0];
+  if (mark) {
+    try {
+      const node = figma.createNodeFromSvg(mark.svg);
+      node.name = 'mark';
+      try {
+        node.fills = [];
+      } catch (e) {
+        /* see above */
+      }
+      f.appendChild(node);
+      const box = 260;
+      const scale = Math.min(box / node.width, box / node.height);
+      if (scale > 0 && scale < 40 && Number.isFinite(scale)) node.rescale(scale);
+      node.x = W - 96 - node.width;
+      node.y = 150;
+    } catch (e) {
+      fail('cover/mark', e);
+    }
+  }
+
+  let x = 96;
+  const strip = DATA.colours.primitive.slice(0, 8);
+  const cellW = (W - 192) / Math.max(strip.length, 1);
+  for (const c of strip) {
+    mkRect(f, 'palette/' + c.name, x, 660, cellW - 4, 180, c.hex);
+    x += cellW;
+  }
+  report.pages.push(page.name);
+  return page;
+}
+
+/* ── tokens page ────────────────────────────────────────────────────────── */
+
+function buildTokensPage(pageName, title) {
+  const page = figma.createPage();
+  page.name = pageName || '12 · Tokens';
+  figma.currentPage = page;
+  const pad = 64;
+  const cell = 190;
+  const cols = 5;
+  const rows = Math.ceil(DATA.colours.primitive.length / cols);
+  const rowStep = cell + 58;
+  const typeStep = (t) => Math.max(64, Math.min(t.size, 72) * (t.lineHeight || 1.2)) + 54;
+  const typeHeight = DATA.type.roles.reduce((n, t) => n + typeStep(t), 0);
+  const spaceHeight = DATA.space.length * 34;
+  const W = pad * 2 + cols * cell;
+  const H =
+    pad + 90 + rows * rowStep + 60 + 60 + typeHeight + 60 + 60 + spaceHeight + pad;
+
+  const f = mkFrame(page, title || 'Tokens', 0, 0, W, H, paper);
+  mkText(f, title || 'Tokens', pad, pad, 44, ink, 'Bold');
+
+  DATA.colours.primitive.forEach((c, i) => {
+    const cx = pad + (i % cols) * cell;
+    const cy = pad + 90 + Math.floor(i / cols) * rowStep;
+    mkRect(f, c.name, cx, cy, cell - 10, cell - 10, c.hex);
+    mkText(f, c.name, cx, cy + cell + 2, 13, ink);
+    mkText(f, c.hex.toUpperCase(), cx, cy + cell + 20, 12, muted);
+  });
+
+  let y = pad + 90 + rows * rowStep + 40;
+  mkText(f, 'Type', pad, y, 32, ink, 'Bold');
+  y += 64;
+  for (const t of DATA.type.roles) {
+    mkText(f, t.name + ' · ' + t.size + 'px', pad, y, 12, muted);
+    mkText(
+      f,
+      DATA.samples[t.name] || DATA.name,
+      pad,
+      y + 20,
+      Math.min(t.size, 72),
+      ink,
+      null,
+      DATA.figBrand ? t.family : null
+    );
+    y += typeStep(t);
+  }
+
+  y += 24;
+  mkText(f, 'Space', pad, y, 32, ink, 'Bold');
+  y += 56;
+  for (const s of DATA.space) {
+    mkRect(f, 'space/' + s.name, pad, y + 4, Math.max(s.px, 2), 18, accent);
+    mkText(f, s.name + ' · ' + s.px + 'px', pad + 220, y + 4, 12, muted);
+    y += 34;
+  }
+  report.pages.push(page.name);
+  return page;
+}
+
+/* ── marks page ─────────────────────────────────────────────────────────── */
+
+function buildMarksPage() {
+  if (!DATA.assets || !DATA.assets.length) return null;
+  const page = figma.createPage();
+  page.name = '13 · Marks';
+  figma.currentPage = page;
+  const pad = 64;
+  const cell = 320;
+  const cols = 3;
+  const rows = Math.ceil(DATA.assets.length / cols);
+  const W = pad * 2 + cols * cell;
+  const H = pad * 2 + 90 + rows * (cell + 36);
+  const f = mkFrame(page, 'Marks', 0, 0, W, H, paper);
+  mkText(f, 'Marks', pad, pad, 44, ink, 'Bold');
+
+  DATA.assets.forEach((a, i) => {
+    const cx = pad + (i % cols) * cell;
+    const cy = pad + 90 + Math.floor(i / cols) * (cell + 36);
+    /* a reverse cut is cream-on-cream without a night plate */
+    const plate = /reverse/i.test(a.name) ? DATA.colours.darkGround || ink : raised;
+    const box = mkFrame(f, a.name, cx, cy, cell - 16, cell - 16, plate);
+    try {
+      /* a raised cell on a paper ground needs an edge at 1x, or the tile reads as a gap */
+      box.strokes = [solid(muted, 0.35)];
+      box.strokeWeight = 1;
+    } catch (e) {
+      /* stroke unsupported; the fill still separates the tile */
+    }
+    try {
+      const node = figma.createNodeFromSvg(a.svg);
+      node.name = a.name;
+      /* the imported frame arrives with a white fill; on a cream sheet that is a
+       * white tile nobody asked for */
+      try {
+        node.fills = [];
+      } catch (e) {
+        /* not a frame in this runtime; the fill is already inherited */
+      }
+      box.appendChild(node);
+      /* up as well as down: a 64px mark in a 300px cell is a postage stamp, and
+       * capping the scale at 1 is why the first clearing board looked empty */
+      const scale = Math.min((box.width - 48) / node.width, (box.height - 48) / node.height);
+      if (scale > 0 && scale < 40 && Number.isFinite(scale)) node.rescale(scale);
+      node.x = Math.max((box.width - node.width) / 2, 0);
+      node.y = Math.max((box.height - node.height) / 2, 0);
+    } catch (e) {
+      fail('mark/' + a.name, e);
+    }
+    mkText(f, a.name, cx, cy + cell - 6, 12, muted);
+  });
+  report.pages.push(page.name);
+  return page;
+}
+
+/* ── polish: the imported page ──────────────────────────────────────────── */
+
+function polishImported() {
+  const pages = figma.root.children;
+  const host = pages.find((p) => p.name === 'Design System') || pages[0];
+  if (!host) {
+    fail('polish', new Error('no page to polish'));
+    return;
+  }
+  figma.currentPage = host;
+
+  /* The import wraps everything in a vertical frame; find the frame whose
+   * children carry the section names, and rename them to read as an index. */
+  const sections = DATA.sections || [];
+  const walk = (node, depth) => {
+    if (!node || depth > 3 || !node.children) return null;
+    const named = node.children.filter((c) => sections.includes(c.name));
+    if (named.length >= Math.max(3, sections.length - 4)) return node;
+    for (const c of node.children) {
+      const hit = walk(c, depth + 1);
+      if (hit) return hit;
+    }
+    return null;
+  };
+  const top = walk(host, 0);
+  if (!top) {
+    fail('polish', new Error('section frames not found'));
+    return;
+  }
+
+  let i = 0;
+  for (const child of top.children) {
+    const idx = sections.indexOf(child.name);
+    if (idx === -1) continue;
+    child.name = String(idx + 1).padStart(2, '0') + ' · ' + child.name;
+    i++;
+  }
+  report.counts.sections = i;
+  report.pages.push(host.name);
+}
+
+/* ── run ────────────────────────────────────────────────────────────────── */
+
+try {
+  if (DATA.mode === 'polish') polishImported();
+  else buildBoard();
+} catch (e) {
+  fail('main', e);
+}
+
+/* polish: the imported page carries the tokens already, so only the index
+ * pages are added. board: there is no page, so the board *is* the tokens. */
+const builders = [
+  buildCover,
+  DATA.mode === 'polish' ? () => buildTokensPage('12 · Tokens', 'Tokens') : () => buildTokensPage('01 · Board', DATA.name),
+  buildMarksPage,
+];
+for (const builder of builders) {
+  try {
+    builder();
+  } catch (e) {
+    fail(builder.name, e);
+  }
+}
+
+/* the 1×1 seed that gave `eval` a document to open is not part of the deliverable */
+if (DATA.mode === 'board') {
+  for (const page of figma.root.children) {
+    if (page.name === 'Design System' && page.children.length <= 1) {
+      try {
+        page.remove();
+      } catch (e) {
+        /* older runtime without page.remove; harmless */
+      }
+    }
+  }
+}
+
+report.counts.pages = figma.root.children.length;
+report.counts.nodes = figma.root.children.reduce((n, p) => n + (p.children ? p.children.length : 0), 0);
+JSON.stringify(report);
