+          continue
+        }
+        await writeFile(join(out, `${b.id}.json`), JSON.stringify(shaped, null, 2))
+        console.log(`ref ${b.id} → ${join(out, `${b.id}.json`)}  (${n} colours, display "${shaped.type.display ?? '—'}")`)
+      }
+    }
+    if (cmd === 'ref')
