@@ -0,0 +1,297 @@
+/* ============================================================================
+ * OpenPencil runtime — build the board from drawing ops.
+ *
+ * Generated by scripts/figma-forge.mjs, run by
+ *   openpencil eval <file>.fig -w --stdin < openpencil-board.js
+ *
+ * The ops come from scripts/board.mjs. Text is a real text node in the brand's
+ * family — not an outlined path — because the SVG importer drops glyphs from a
+ * path placed far from the origin. That also means the export stays editable.
+ *
+ * Raster plates (the material photograph) are placed with createImage, because
+ * <image> inside an imported SVG is dropped by this runtime.
+ * ==========================================================================*/
+
+const DATA = __DATA__;
+
+const report = { pages: [], errors: [], nodes: 0, fonts: {} };
+
+function fail(where, e) {
+  report.errors.push(where + ': ' + ((e && e.message) || String(e)))
+}
+
+const rgb = (hex) => {
+  let h = String(hex || '#000').replace('#', '')
+  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2]
+  const v = parseInt(h.slice(0, 6), 16) || 0
+  return { r: ((v >> 16) & 255) / 255, g: ((v >> 8) & 255) / 255, b: (v & 255) / 255 }
+}
+const paint = (hex, opacity) => ({
+  type: 'SOLID',
+  color: rgb(hex),
+  opacity: opacity == null ? 1 : opacity,
+})
+
+function bytesFromBase64(b64) {
+  const bin = atob(b64)
+  const out = new Uint8Array(bin.length)
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i)
+  return out
+}
+
+function makeRect(frame, op) {
+  const r = figma.createRectangle()
+  r.name = op.name || op.fill || 'rect'
+  r.resize(Math.max(op.w, 0.01), Math.max(op.h, 0.01))
+  r.x = op.x
+  r.y = op.y
+  r.fills = op.fill && op.fill !== 'none' ? [paint(op.fill, op.opacity)] : []
+  if (op.radius) {
+    try {
+      r.cornerRadius = op.radius
+    } catch (e) {
+      /* not every runtime accepts a radius */
+    }
+  }
+  if (op.stroke) {
+    try {
+      r.strokes = [paint(op.stroke, Math.min(op.opacity == null ? 1 : op.opacity, 1))]
+      r.strokeWeight = op.sw || 1
+    } catch (e) {
+      /* stroke unsupported */
+    }
+  }
+  frame.appendChild(r)
+  report.nodes += 1
+}
+
+function makeLine(frame, op) {
+  const horizontal = Math.abs(op.y2 - op.y1) < 0.5
+  const w = horizontal ? Math.abs(op.x2 - op.x1) : op.sw || 1
+  const h = horizontal ? op.sw || 1 : Math.abs(op.y2 - op.y1)
+  makeRect(frame, {
+    x: Math.min(op.x1, op.x2),
+    y: Math.min(op.y1, op.y2),
+    w,
+    h,
+    fill: op.stroke,
+    opacity: op.opacity,
+    name: 'rule',
+  })
+}
+
+function makeCircle(frame, op) {
+  const size = op.r * 2
+  const svg =
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' +
+    size +
+    ' ' +
+    size +
+    '" width="' +
+    size +
+    '" height="' +
+    size +
+    '"><circle cx="' +
+    op.r +
+    '" cy="' +
+    op.r +
+    '" r="' +
+    op.r +
+    '" fill="' +
+    op.fill +
+    '"/></svg>'
+  const node = figma.createNodeFromSvg(svg)
+  node.name = 'dot'
+  frame.appendChild(node)
+  node.x = op.cx - op.r
+  node.y = op.cy - op.r
+  report.nodes += 1
+}
+
+function makeVector(frame, op) {
+  const vb = op.vb || [0, 0, op.w, op.h]
+  const svg =
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="' +
+    vb.join(' ') +
+    '" width="' +
+    op.w +
+    '" height="' +
+    op.h +
+    '">' +
+    op.inner +
+    '</svg>'
+  const node = figma.createNodeFromSvg(svg)
+  node.name = op.name || 'vector'
+  /* the imported frame arrives with a white fill; a placed mark must be clear */
+  try {
+    node.fills = []
+  } catch (e) {
+    /* not a frame */
+  }
+  frame.appendChild(node)
+  node.x = op.x
+  node.y = op.y
+  if (op.w && op.h && node.width && Math.abs(node.width - op.w) > 1) {
+    try {
+      node.resize(op.w, op.h)
+    } catch (e) {
+      /* the importer already sized it from the viewBox */
+    }
+  }
+  report.nodes += 1
+}
+
+/** One node per chunk of glyphs: the importer drops glyphs from a long path. */
+function makeGlyphs(frame, op) {
+  for (const c of op.chunks || []) {
+    const svg =
+      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="' +
+      c.vb.join(' ') +
+      '" width="' +
+      c.w +
+      '" height="' +
+      c.h +
+      '"><path d="' +
+      c.d +
+      '" fill="' +
+      op.colour +
+      '"' +
+      (op.opacity != null && op.opacity < 1 ? ' opacity="' + op.opacity + '"' : '') +
+      '/></svg>'
+    const node = figma.createNodeFromSvg(svg)
+    node.name = (op.text || '').slice(0, 32)
+    /* the imported frame arrives with a white fill; a text tile must be clear */
+    try {
+      node.fills = []
+    } catch (e) {
+      /* not a frame */
+    }
+    frame.appendChild(node)
+    node.x = c.x
+    node.y = c.y
+    report.nodes += 1
+    report.glyphs = (report.glyphs || 0) + 1
+  }
+}
+
+function makeText(frame, op) {
+  const t = figma.createText()
+  t.name = op.text.slice(0, 40)
+  try {
+    t.fontName = { family: op.family, style: op.weight || 'Regular' }
+    report.fonts[op.family] = (report.fonts[op.family] || 0) + 1
+  } catch (e) {
+    /* the runtime falls back to its own face; the family name is kept below */
+    report.fonts['fallback:' + op.family] = (report.fonts['fallback:' + op.family] || 0) + 1
+  }
+  t.fontSize = op.size
+  try {
+    t.resize(Math.max(op.w || 10, 10) + op.size, op.size * 1.6)
+  } catch (e) {
+    /* fixed width unavailable */
+  }
+  t.characters = op.text
+  t.fills = [paint(op.colour, op.opacity)]
+  if (op.tracking) {
+    try {
+      t.letterSpacing = { unit: 'PIXELS', value: op.tracking * op.size }
+    } catch (e) {
+      /* tracking unsupported */
+    }
+  }
+  try {
+    t.textAutoResize = 'WIDTH_AND_HEIGHT'
+  } catch (e) {
+    /* default is fine */
+  }
+  frame.appendChild(t)
+  /* op.y is the cap top; a text box starts at baseline − ascent */
+  t.x = op.x
+  t.y = op.y + (op.cap || 0) - (op.ascent || op.size * 0.8)
+  report.nodes += 1
+}
+
+function placeImage(frame, img) {
+  const src = (DATA.images || {})[img.src]
+  if (!src) return
+  const r = figma.createRectangle()
+  r.name = 'image/' + img.src
+  r.resize(img.w, img.h)
+  r.x = img.x
+  r.y = img.y
+  if (img.radius) {
+    try {
+      r.cornerRadius = img.radius
+    } catch (e) {
+      /* ignore */
+    }
+  }
+  try {
+    const image = figma.createImage(bytesFromBase64(src))
+    r.fills = [{ type: 'IMAGE', imageHash: image.hash, scaleMode: 'FILL' }]
+  } catch (e) {
+    r.fills = [paint(DATA.colours.raised)]
+  }
+  frame.appendChild(r)
+  report.nodes += 1
+}
+
+/* ── run ────────────────────────────────────────────────────────────────── */
+
+const seed = figma.root.children.find((p) => p.name === 'Design System' || /^Page \d+$/.test(p.name))
+
+for (const s of DATA.board || []) {
+  let page
+  let frame
+  try {
+    page = figma.createPage()
+    page.name = s.name
+    figma.currentPage = page
+    frame = figma.createFrame()
+    frame.name = s.name
+    frame.resize(s.w, s.h)
+    frame.x = 0
+    frame.y = 0
+    frame.fills = [paint(DATA.colours.paper)]
+    frame.clipsContent = true
+    page.appendChild(frame)
+    report.nodes += 1
+  } catch (e) {
+    fail('page/' + s.name, e)
+    continue
+  }
+
+  for (const op of s.ops || []) {
+    try {
+      if (op.op === 'rect') makeRect(frame, op)
+      else if (op.op === 'line') makeLine(frame, op)
+      else if (op.op === 'circle') makeCircle(frame, op)
+      else if (op.op === 'glyphs') makeGlyphs(frame, op)
+      else if (op.op === 'text') makeText(frame, op)
+      else if (op.op === 'vector') makeVector(frame, op)
+    } catch (e) {
+      fail(s.id + '/' + op.op, e)
+    }
+  }
+
+  for (const img of s.images || []) {
+    try {
+      placeImage(frame, img)
+    } catch (e) {
+      fail(s.id + '/image', e)
+    }
+  }
+
+  report.pages.push(s.name)
+}
+
+if (seed && seed.children.length <= 1) {
+  try {
+    seed.remove()
+  } catch (e) {
+    /* older runtime without page.remove */
+  }
+}
+
+report.pages_total = figma.root.children.length
+JSON.stringify(report)
