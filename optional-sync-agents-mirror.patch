+  const parts = []
+  for (const ch of str) {
+    const glyph = font.charToGlyph(ch)
+    const gp = font.getPath(ch, cx, baseline, size)
+    const gb = gp.getBoundingBox()
+    if (gb.x2 > gb.x1) parts.push(gp.toPathData(1))
+    cx += (glyph.advanceWidth / font.unitsPerEm) * size + tracking
+  }
