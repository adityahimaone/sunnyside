+    }
+    const seen = new Set()
+    const rows = hits.sort((a, c) => a.d - c.d).filter((h) => !seen.has(h.b.id) && seen.add(h.b.id))
+    rows.forEach((h) => console.log(`${h.b.name.padEnd(18)} ${h.hex}  ${h.d.toFixed(0)}° away   (${h.b.category})`))
