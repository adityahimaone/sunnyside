+  strip.itemSpacing = 0;
+  strip.paddingTop = 0;
+  strip.paddingLeft = 0;
+  for (const c of DATA.colours.primitive.slice(0, 8)) {
+    const cell = frame(strip, c.name, 0, 0, 100, 160, c.hex);
+    cell.layoutGrow = 1;
+    cell.layoutAlign = 'STRETCH';
+  }
+
+  await text(f, DATA.meta || '', 0, 0, {
+    size: 14,
+    colour: DATA.colours.inkMuted || DATA.colours.ink,
+    family: DATA.type.families.label,
+    width: W - 192,
+  });
+  say('cover');
+  return page;
+}
+
+async function colourPage() {
+  const page = figma.createPage();
+  page.name = '01 · Colour';
+  figma.currentPage = page;
+  const pad = 64;
+  const cell = 200;
+  const cols = 5;
+  const rows = Math.ceil(DATA.colours.primitive.length / cols);
+  const W = pad * 2 + cols * cell;
+  const H = pad * 2 + rows * (cell + 44) + 120;
+  const f = frame(page, 'Colour', 0, 0, W, H, DATA.colours.paper);
+
+  await text(f, 'Colour', pad, pad, { size: 48, weight: 'Bold', colour: DATA.colours.ink });
+
+  DATA.colours.primitive.forEach((c, i) => {
+    const x = pad + (i % cols) * cell;
+    const y = pad + 96 + Math.floor(i / cols) * (cell + 44);
+    const chip = rect(f, c.name, x, y, cell - 8, cell - 8, c.hex);
+    const v = vars.colour[c.name];
+    if (v) chip.fills = [figma.variables.setBoundVariableForPaint(solid(c.hex), 'color', v)];
+    const label = c.name + '  ' + c.hex;
+    text(f, label, x, y + cell, {
+      size: 13,
+      colour: DATA.colours.ink,
+      family: DATA.type.families.label,
+    });
+  });
+  say('colour');
+  return page;
+}
+
+async function typePage() {
+  const page = figma.createPage();
+  page.name = '02 · Type';
+  figma.currentPage = page;
+  const pad = 64;
+  const W = 1280;
+  let H = pad * 2 + 80;
+  for (const t of DATA.type.roles) H += Math.max(64, t.size * (t.lineHeight || 1.2)) + 56;
+  const f = frame(page, 'Type', 0, 0, W, H, DATA.colours.paper);
+  await text(f, 'Type', pad, pad, { size: 48, weight: 'Bold', colour: DATA.colours.ink });
+
+  let y = pad + 96;
+  for (const t of DATA.type.roles) {
+    await text(f, t.name + ' · ' + t.size + 'px · ' + Math.round((t.lineHeight || 1.2) * 100) + '%', pad, y, {
+      size: 13,
+      colour: DATA.colours.inkMuted || DATA.colours.ink,
+      family: DATA.type.families.label,
+    });
+    const sample = DATA.samples[t.name] || DATA.name;
+    await text(f, sample, pad, y + 22, {
+      size: Math.min(t.size, 96),
+      weight: t.weight,
+      colour: DATA.colours.ink,
+      family: t.family,
+      tracking: t.tracking,
+      lineHeight: t.lineHeight,
+      width: W - pad * 2,
+    });
+    y += Math.max(64, t.size * (t.lineHeight || 1.2)) + 56;
+  }
+  say('type');
+  return page;
+}
+
+async function spacePage() {
+  const page = figma.createPage();
+  page.name = '03 · Space & radius';
+  figma.currentPage = page;
+  const pad = 64;
+  const W = 1200;
+  const H = pad * 2 + 120 + DATA.space.length * 44 + DATA.radius.length * 90;
+  const f = frame(page, 'Space and radius', 0, 0, W, H, DATA.colours.paper);
+  await text(f, 'Space & radius', pad, pad, { size: 48, weight: 'Bold', colour: DATA.colours.ink });
+
+  let y = pad + 96;
+  for (const s of DATA.space) {
+    rect(f, 'space/' + s.name, pad, y, Math.max(s.px, 2), 24, DATA.colours.accent);
+    await text(f, s.name + ' · ' + s.px + 'px', pad + 220, y + 2, {
+      size: 13,
+      colour: DATA.colours.ink,
+      family: DATA.type.families.label,
+    });
+    y += 44;
+  }
+
+  y += 24;
+  let x = pad;
+  for (const r of DATA.radius) {
+    rect(f, 'radius/' + r.name, x, y, 96, 96, DATA.colours.raised || DATA.colours.paper, Math.min(r.px, 48));
+    await text(f, r.name + ' · ' + r.px + 'px', x, y + 104, {
+      size: 13,
+      colour: DATA.colours.ink,
+      family: DATA.type.families.label,
+    });
+    x += 140;
+  }
+  say('space + radius');
+  return page;
+}
+
+async function marksPage() {
+  if (!DATA.assets || !DATA.assets.length) return null;
+  const page = figma.createPage();
+  page.name = '04 · Marks';
+  figma.currentPage = page;
+  const pad = 64;
+  const cell = 320;
+  const cols = 3;
+  const rows = Math.ceil(DATA.assets.length / cols);
+  const W = pad * 2 + cols * cell;
+  const H = pad * 2 + 96 + rows * (cell + 40);
+  const f = frame(page, 'Marks', 0, 0, W, H, DATA.colours.paper);
+  await text(f, 'Marks', pad, pad, { size: 48, weight: 'Bold', colour: DATA.colours.ink });
+
+  for (let i = 0; i < DATA.assets.length; i++) {
+    const a = DATA.assets[i];
+    const x = pad + (i % cols) * cell;
+    const y = pad + 96 + Math.floor(i / cols) * (cell + 40);
+    const cellFrame = frame(f, a.name, x, y, cell - 16, cell - 16, DATA.colours.raised || DATA.colours.paper);
+    try {
+      const node = figma.createNodeFromSvg(a.svg);
+      node.name = a.name;
+      cellFrame.appendChild(node);
+      const box = cellFrame.width - 48;
+      const scale = Math.min(box / node.width, (cellFrame.height - 96) / node.height, 1);
+      node.rescale(scale);
+      node.x = (cellFrame.width - node.width) / 2;
+      node.y = (cellFrame.height - node.height) / 2;
+    } catch (e) {
+      fail('mark/' + a.name, e);
+    }
+    await text(f, a.name, x, y + cell - 8, {
+      size: 13,
+      colour: DATA.colours.ink,
+      family: DATA.type.families.label,
+    });
+  }
+  say('marks: ' + DATA.assets.length);
+  return page;
+}
+
+async function componentPage() {
+  const page = figma.createPage();
+  page.name = '05 · Components';
+  figma.currentPage = page;
+  const pad = 64;
+  const f = frame(page, 'Components', 0, 0, 1440, 1200, DATA.colours.paper);
+  await text(f, 'Components', pad, pad, { size: 48, weight: 'Bold', colour: DATA.colours.ink });
+
+  const font = await loadFont(DATA.type.families.reading, 'Medium');
+  const label = { size: 13, colour: DATA.colours.inkMuted || DATA.colours.ink, family: DATA.type.families.label };
+
+  /* button variants */
+  const intents = ['Primary', 'Secondary', 'Ghost'];
+  const states = ['Default', 'Disabled'];
+  const made = [];
+  const host = frame(f, 'Button', pad, pad + 110, 900, 300, null);
+  host.layoutMode = 'HORIZONTAL';
+  host.itemSpacing = 16;
+  host.paddingTop = 16;
+  host.paddingLeft = 16;
+  host.counterAxisSizingMode = 'AUTO';
+
+  for (const intent of intents) {
+    for (const state of states) {
+      try {
+        const c = figma.createComponent();
+        c.name = 'Intent=' + intent + ', State=' + state;
+        c.layoutMode = 'HORIZONTAL';
+        c.primaryAxisSizingMode = 'AUTO';
+        c.counterAxisSizingMode = 'AUTO';
+        c.paddingTop = 12;
+        c.paddingBottom = 12;
+        c.paddingLeft = 22;
+        c.paddingRight = 22;
+        c.itemSpacing = 8;
+        c.cornerRadius = DATA.radius.length ? DATA.radius[0].px : 0;
+        const bg =
+          intent === 'Primary'
+            ? DATA.colours.accent
+            : intent === 'Secondary'
+              ? DATA.colours.raised || DATA.colours.paper
+              : null;
+        c.fills = bg ? [solid(bg)] : [];
+        if (intent === 'Secondary') {
+          c.strokes = [solid(DATA.colours.line || DATA.colours.ink)];
+          c.strokeWeight = 1;
+        }
+        const t = figma.createText();
+        t.fontName = font;
+        t.characters = 'Button';
+        t.fontSize = 15;
+        t.fills = [solid(intent === 'Primary' ? DATA.colours.onAccent || '#ffffff' : DATA.colours.ink)];
+        c.appendChild(t);
+        if (state === 'Disabled') c.opacity = 0.4;
+        host.appendChild(c);
+        made.push(c);
+      } catch (e) {
+        fail('button/' + intent + '/' + state, e);
+      }
+    }
+  }
+  if (made.length) {
+    try {
+      const set = figma.combineAsVariants(made, host);
+      set.name = 'Button';
+      say('button set: ' + made.length + ' variants');
+    } catch (e) {
+      fail('combine/button', e);
+    }
+  }
+
+  /* input states */
+  const inputs = [];
+  const inputHost = frame(f, 'Input', pad, pad + 470, 900, 260, null);
+  inputHost.layoutMode = 'HORIZONTAL';
+  inputHost.itemSpacing = 16;
+  inputHost.paddingTop = 16;
+  inputHost.paddingLeft = 16;
+  for (const state of ['Default', 'Focus', 'Error', 'Disabled']) {
+    try {
+      const c = figma.createComponent();
+      c.name = 'State=' + state;
+      c.layoutMode = 'HORIZONTAL';
+      c.primaryAxisSizingMode = 'AUTO';
+      c.counterAxisSizingMode = 'AUTO';
+      c.paddingTop = 12;
+      c.paddingBottom = 12;
+      c.paddingLeft = 14;
+      c.paddingRight = 14;
+      c.cornerRadius = DATA.radius.length ? DATA.radius[0].px : 0;
+      c.fills = [solid(DATA.colours.raised || DATA.colours.paper)];
+      c.strokes = [solid(state === 'Error' ? DATA.colours.danger || DATA.colours.accent : DATA.colours.line || DATA.colours.ink)];
+      c.strokeWeight = state === 'Focus' ? 2 : 1;
+      const t = figma.createText();
+      t.fontName = font;
+      t.characters = state === 'Default' ? 'Placeholder' : state;
+      t.fontSize = 15;
+      t.fills = [solid(state === 'Default' ? DATA.colours.inkMuted || DATA.colours.ink : DATA.colours.ink)];
+      c.appendChild(t);
+      if (state === 'Disabled') c.opacity = 0.4;
+      inputHost.appendChild(c);
+      inputs.push(c);
+    } catch (e) {
+      fail('input/' + state, e);
+    }
+  }
+  if (inputs.length) {
+    try {
+      const set = figma.combineAsVariants(inputs, inputHost);
+      set.name = 'Input';
+      say('input set: ' + inputs.length + ' variants');
+    } catch (e) {
+      fail('combine/input', e);
+    }
+  }
+
+  await text(f, 'Every state above is a variant, not a screenshot. Focus is a 2px ring, never a colour swap alone.', pad, pad + 780, {
+    ...label,
+    width: 900,
+  });
+  say('components');
+  return page;
+}
+
+/* ── main ───────────────────────────────────────────────────────────────── */
+
+async function main() {
+  try {
+    buildVariables();
+  } catch (e) {
+    fail('variables', e);
+  }
+  try {
+    buildPaintStyles();
+  } catch (e) {
+    fail('paint styles', e);
+  }
+  try {
+    await buildTextStyles();
+  } catch (e) {
+    fail('text styles', e);
+  }
+  try {
+    buildEffectStyles();
+  } catch (e) {
+    fail('effect styles', e);
+  }
+  try {
+    buildGridStyles();
+  } catch (e) {
+    fail('grid styles', e);
+  }
+
+  for (const builder of [coverPage, colourPage, typePage, spacePage, marksPage, componentPage]) {
+    try {
+      await builder();
+    } catch (e) {
+      fail(builder.name, e);
+    }
+  }
+
+  /* Figma opens a new file on an empty "Page 1"; leaving it makes the export
+   * look like a draft. Remove it only when nothing was built into it. */
+  try {
+    for (const page of figma.root.children) {
+      if (/^Page \d+$/.test(page.name) && page.children.length === 0) page.remove()
+    }
+  } catch (e) {
+    fail('page cleanup', e)
+  }
+
+  const summary = report.errors.length
+    ? DATA.name + ': built ' + report.built.length + ', ' + report.errors.length + ' failed'
+    : DATA.name + ': ' + report.built.length + ' sections built';
+  figma.notify(summary, { timeout: 6000 });
+  if (report.errors.length) {
+    for (const e of report.errors) console.error('[forge] ' + e);
+  }
+  figma.closePlugin(summary);
+}
+
+main();
