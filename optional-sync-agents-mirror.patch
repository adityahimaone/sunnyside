+  'inter',
+  'jetbrains mono',
+  'roboto',
+  'roboto mono',
+  'open sans',
+  'lato',
+  'source sans pro',
+  'source serif pro',
+  'ibm plex sans',
+  'ibm plex mono',
+  'ibm plex serif',
+  'noto sans',
+  'noto serif',
+  'fira sans',
+  'fira code',
+])
+
+const requestedFigFont = opt['fig-font'] || ''
+let figFont = families.reading
+let figFontNote = ''
