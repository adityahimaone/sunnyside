+const mids = scored.filter((p) => p.L > 0.35 && p.L < 0.8 && p.C < 0.06)
+const roleOf = {
+  primary: byL[0],
+  neutral: byL[byL.length - 1],
+  tertiary: accent,
+  secondary: mids[0] ?? byL[1],
+}
