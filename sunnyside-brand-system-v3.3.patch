+    return
+  }
+
+  if (cmd === 'search') {
+    if (!pos.length) die('search needs at least one word')
+    const words = pos.map((w) => w.toLowerCase())
+    const scored = list
+      .map((b) => {
+        const hay = `${b.name} ${b.category} ${b.tags.join(' ')} ${b.description}`.toLowerCase()
+        return { b, n: words.filter((w) => hay.includes(w)).length }
+      })
+      .filter((x) => x.n)
+      .sort((a, c) => c.n - a.n)
