+        fill="none"
+        stroke={INK}
+        strokeWidth="2.6"
+        strokeLinecap="round"
+        opacity="0.7"
+      />
+      <path
+        d={d}
+        fill="none"
+        stroke={color}
+        strokeWidth="1.5"
+        strokeLinecap="round"
+      />
+    </g>
+  )
+}
+
+function Gear({
+  cx,
+  cy,
+  outer,
+  root,
+  teeth,
+  fill,
+  stroke,
+  hub,
+  holes,
+  holeRadius,
+  holeFill,
+  className,
+  style,
+}: {
+  cx: number
+  cy: number
+  outer: number
+  root: number
+  teeth: number
+  fill: string
+  stroke: string
+  hub: number
+  holes: number
+  holeRadius: number
+  holeFill: string
+  className?: string
+  style?: CSSProperties
+}) {
+  return (
+    <g className={className} style={style} filter="url(#dg-s2)">
+      <path
+        d={gearPath(cx, cy, outer, root, teeth)}
+        fill={fill}
+        stroke={stroke}
+        strokeWidth="0.9"
+        strokeLinejoin="round"
+      />
+      <circle
+        cx={cx}
+        cy={cy}
+        r={root - 3}
+        fill="none"
+        stroke={stroke}
+        strokeOpacity="0.55"
+        strokeWidth="0.6"
+      />
+      {Array.from({ length: holes }, (_, i) => {
+        const a = (i / holes) * Math.PI * 2
+        const rr = (root - 3 + hub) / 2
+        return (
+          <circle
+            key={i}
+            cx={cx + Math.cos(a) * rr}
+            cy={cy + Math.sin(a) * rr}
+            r={holeRadius}
+            fill={holeFill}
+            stroke={stroke}
+            strokeWidth="0.6"
+          />
+        )
+      })}
+      <circle
+        cx={cx}
+        cy={cy}
+        r={hub}
+        fill={fill}
+        stroke={stroke}
+        strokeWidth="0.9"
+      />
+      <circle
+        cx={cx}
+        cy={cy}
+        r={hub * 0.42}
+        fill="#e9e1cd"
+        stroke={stroke}
+        strokeWidth="0.7"
+      />
+    </g>
+  )
+}
