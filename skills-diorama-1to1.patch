+    <g transform={`translate(${x} ${y}) scale(${w / 100} ${h / 56})`}>
+      <g className={className} style={style}>
+        <path d={d} fill={shade} transform="translate(1.5 4)" opacity="0.55" />
+        <path
+          d={d}
+          fill={fill}
+          stroke={stroke}
+          strokeWidth="1.4"
+          vectorEffect="non-scaling-stroke"
+        />
