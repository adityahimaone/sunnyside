diff --git a/features/landing-page/studio/hero/hero-scene.module.css b/features/landing-page/studio/hero/hero-scene.module.css
new file mode 100644
index 0000000..467dd8c
--- /dev/null
+++ b/features/landing-page/studio/hero/hero-scene.module.css
@@ -0,0 +1,370 @@
+/* The hero's paper-cut sunrise. Geometry comes from three variables the hero
+   declares (--sun-size, --sun-x, --ground); everything here is positioned from
+   the sun's centre, so one number rescales the whole picture. */
+
+@property --gap {
+  syntax: '<length>';
+  inherits: true;
+  initial-value: 7px;
+}
+
+.scene {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  overflow: hidden;
+  pointer-events: none;
+}
+
+/* Flat bands, hard-edged like a screen print. The lightest sit behind the sun. */
+.sky {
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(
+    circle at var(--sun-x) calc(100% - var(--ground) - var(--sun-size) * 0.28),
+    #5266e4 0 calc(var(--sun-size) * 0.5),
+    #4a5fe0 calc(var(--sun-size) * 0.5) calc(var(--sun-size) * 0.68),
+    #4358da calc(var(--sun-size) * 0.68) calc(var(--sun-size) * 0.92),
+    var(--cobalt) calc(var(--sun-size) * 0.92)
+  );
+}
+
+/* A zero-size anchor on the sun's centre. */
+.anchor {
+  position: absolute;
+  left: var(--sun-x);
+  top: calc(100% - var(--ground) - var(--sun-size) * 0.28);
+  width: 0;
+  height: 0;
+}
+
+.rays {
+  position: absolute;
+  --ray: min(150vmax, 1900px);
+  left: calc(var(--ray) / -2);
+  top: calc(var(--ray) / -2);
+  width: var(--ray);
+  height: var(--ray);
+  background: repeating-conic-gradient(
+    from 0deg,
+    rgb(255 250 241 / 0.085) 0 6deg,
+    transparent 6deg 12deg
+  );
+  -webkit-mask-image: radial-gradient(circle, #000 0 20%, transparent 56%);
+  mask-image: radial-gradient(circle, #000 0 20%, transparent 56%);
+  will-change: rotate;
+}
+
+.dots {
+  position: absolute;
+  left: calc(var(--sun-size) * -0.92);
+  top: calc(var(--sun-size) * -0.92);
+  width: calc(var(--sun-size) * 1.84);
+  height: calc(var(--sun-size) * 1.84);
+  background: radial-gradient(rgb(255 250 241 / 0.55) 1.1px, transparent 1.5px)
+    0 0 / 16px 16px;
+  -webkit-mask-image: radial-gradient(
+    circle,
+    transparent 36%,
+    #000 38% 52%,
+    transparent 56%
+  );
+  mask-image: radial-gradient(
+    circle,
+    transparent 36%,
+    #000 38% 52%,
+    transparent 56%
+  );
+  opacity: 0.5;
+}
+
+.farHill {
+  position: absolute;
+  inset-inline: -3%;
+  bottom: calc(var(--ground) - 8px);
+  height: calc(var(--ground) * 1.9);
+}
+
+.ground {
+  position: absolute;
+  inset-inline: -3%;
+  bottom: -2px;
+  height: calc(var(--ground) + 2px);
+}
+
+.farHill svg,
+.ground svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+/* ── The sun ───────────────────────────────────────────────────────────── */
+
+.sunLift {
+  position: absolute;
+  left: calc(var(--sun-size) / -2);
+  top: calc(var(--sun-size) / -2);
+  width: var(--sun-size);
+  height: var(--sun-size);
+  will-change: translate, scale;
+}
+
+/* Fills the lift wrapper; only the lift is offset from the anchor. */
+.sunRise {
+  position: absolute;
+  inset: 0;
+  animation: sun-rise 1.5s cubic-bezier(0.34, 1.32, 0.5, 1) 0.15s both;
+}
+
+.sunBody {
+  position: absolute;
+  inset: 0;
+  transform-style: preserve-3d;
+  transform: perspective(1100px);
+  animation: slices-open 1.1s var(--ease-out) 0.7s both;
+  will-change: transform;
+}
+
+.layer {
+  position: absolute;
+  inset: 0;
+}
+
+.layer svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+.slice {
+  color: var(--ink);
+  transform: translateZ(calc(var(--i) * var(--gap) * -1));
+}
+
+/* The shadow the cut-out throws on the sky, set well behind it. */
+.plate {
+  color: rgb(25 26 46 / 0.3);
+  transform: translate3d(
+    calc(var(--sun-size) * 0.035),
+    calc(var(--sun-size) * 0.05),
+    calc(var(--gap) * -8)
+  );
+}
+
+.face {
+  transform: translateZ(0);
+}
+
+/* Rings leave the sun on the beat of the headline's word, three times. */
+.pulse {
+  position: absolute;
+  inset: 8%;
+  border: 2.5px solid var(--butter);
+  border-radius: 50%;
+  opacity: 0;
+  transform: translateZ(calc(var(--gap) * -9));
+  /* Three rings leave the sun after it has risen, then it is still. */
+  animation: pulse-out 2.6s cubic-bezier(0.2, 0.7, 0.3, 1) 2.1s 1 both;
+}
+
+.pulse:nth-of-type(2) {
+  animation-delay: 2.7s;
+}
+
+.pulse:nth-of-type(3) {
+  animation-delay: 3.3s;
+}
+
+/* The drift also holds while the hero is off screen. */
+[data-scene-idle='true'] .float {
+  animation-play-state: paused;
+}
+
+/* ── Items placed from the sun's centre ───────────────────────────────── */
+
+.item {
+  position: absolute;
+  left: calc(var(--sun-size) * var(--ox));
+  top: calc(var(--sun-size) * var(--oy) * var(--ky, 1));
+  will-change: translate;
+}
+
+.cloud {
+  width: calc(clamp(6.2rem, 12vw, 10.5rem) * var(--s, 1));
+  margin: -0.4em 0 0 -3em;
+  filter: drop-shadow(5px 6px 0 rgb(25 26 46 / 0.28));
+  animation: drift-in 1.4s var(--ease-out) var(--delay, 0.6s) both;
+}
+
+.cloud svg {
+  display: block;
+  width: 100%;
+}
+
+.sticker {
+  position: relative;
+  width: clamp(3.1rem, 6.2vw, 5.4rem);
+  margin: -1.9rem 0 0 -1.9rem;
+  animation: sticker-pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) var(--delay, 1s)
+    both;
+}
+
+.float {
+  display: block;
+  /* A few slow drifts after the entrance, then it rests: nothing here runs
+     forever, so an idle hero costs no frames. */
+  animation: bob 6s ease-in-out 2.4s 4 alternate both;
+}
+
+.sticker[data-slot='smiley'] .float {
+  animation-delay: -1.6s;
+}
+.sticker[data-slot='burst'] .float {
+  animation-delay: -2.4s;
+}
+.sticker[data-slot='daisy'] .float {
+  animation-delay: -3.2s;
+}
+.sticker[data-slot='bolt'] .float {
+  animation-delay: -4.1s;
+}
+
+/* The filter lives on the drawing, not on the element that moves: a filter on
+   a parent of something animating is re-run every frame, on the drawing it is
+   rasterised once. Warm rim upper-left, hard ink shadow lower-right. */
+.float svg {
+  display: block;
+  width: 100%;
+  filter: drop-shadow(3px 5px 0 rgb(25 26 46 / 0.3))
+    drop-shadow(-1.5px -1.5px 0 rgb(255 210 63 / 0.3));
+}
+
+/* Once the stickers have fallen into the About tray, the hero keeps the
+   outline they left, so scrolling back up reads as a peeled sheet. */
+.sticker::before {
+  content: '';
+  position: absolute;
+  inset: 8%;
+  border: 2px dashed rgb(255 250 241 / 0.7);
+  border-radius: 50%;
+  opacity: 0;
+  transition: opacity 0.4s ease 0.2s;
+}
+
+.sticker[data-peeled='true']::before {
+  opacity: 1;
+}
+
+.sticker[data-peeled='true'] .float {
+  opacity: 0;
+  animation: none;
+}
+
+.sparkle {
+  display: block;
+  width: 0.95rem;
+  margin: -0.5rem 0 0 -0.5rem;
+  color: var(--butter);
+  animation: twinkle 3s ease-in-out 2.4s 3;
+}
+
+.sparkPaper {
+  color: var(--paper-hi);
+  width: 0.7rem;
+}
+
+.item:nth-of-type(2n) .sparkle {
+  animation-delay: 3.1s;
+}
+
+/* ── Keyframes ────────────────────────────────────────────────────────── */
+
+@keyframes sun-rise {
+  from {
+    transform: translateY(58%) scale(0.88);
+  }
+}
+
+@keyframes slices-open {
+  from {
+    --gap: 0px;
+  }
+}
+
+@keyframes pulse-out {
+  0% {
+    transform: translateZ(calc(var(--gap) * -9)) scale(0.8);
+    opacity: 0.6;
+  }
+  70%,
+  100% {
+    transform: translateZ(calc(var(--gap) * -9)) scale(1.95);
+    opacity: 0;
+  }
+}
+
+@keyframes drift-in {
+  from {
+    transform: translateX(-46px);
+    opacity: 0;
+  }
+}
+
+@keyframes sticker-pop {
+  from {
+    transform: scale(0.2) rotate(-24deg);
+    opacity: 0;
+  }
+}
+
+@keyframes bob {
+  to {
+    transform: translateY(-9px) rotate(2.5deg);
+  }
+}
+
+@keyframes twinkle {
+  0%,
+  100% {
+    transform: scale(0.75) rotate(0deg);
+    opacity: 0.55;
+  }
+  50% {
+    transform: scale(1.15) rotate(18deg);
+    opacity: 1;
+  }
+}
+
+/* The Sticker Boot covers the page on a first visit. Hold every entrance until
+   it has peeled away, or it would play unseen underneath. */
+:global(html[data-boot='on']) .scene *,
+:global(html[data-boot='on']) .scene *::before {
+  animation-play-state: paused;
+}
+
+/* Below the desktop split the sun sits under the copy, so the cluster around
+   it is squashed toward the sun rather than reaching up into the text. */
+@media (max-width: 1023px) {
+  .scene {
+    --ky: 0.42;
+  }
+}
+
+@media (max-width: 639px) {
+  .sparkle,
+  .sparkPaper {
+    display: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .scene *,
+  .scene *::before {
+    animation: none !important;
+  }
+
+  .sunBody {
+    transform: none;
+  }
+}
