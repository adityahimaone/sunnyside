+import { useId } from 'react'
+
+type StampProps = {
+  /** Printed round the rim; repeated to fill the circle. */
+  text: string
+  fill: string
+  className?: string
+}
+
+/**
+ * A round die-cut stamp with its words set on a circle. Drawn like the other
+ * stickers: a paper rim, an ink face, one flat colour, no gradient.
+ */
+export function Stamp({ text, fill, className }: StampProps) {
+  const id = useId()
+  const ring = `${text} · ${text} · `
+  return (
+    <svg
+      viewBox="0 0 120 120"
+      className={className}
+      aria-hidden
+      focusable="false"
+    >
+      <defs>
+        <path id={id} d="M60 60m-37 0a37 37 0 1 1 74 0a37 37 0 1 1 -74 0" />
+      </defs>
+      <circle
+        cx="60"
+        cy="60"
+        r="52"
+        fill={fill}
+        stroke="var(--paper-hi, #fffaf1)"
+        strokeWidth="8"
+      />
+      <circle
+        cx="60"
+        cy="60"
+        r="46"
+        fill="none"
+        stroke="var(--ink, #191a2e)"
+        strokeWidth="1.6"
+        strokeDasharray="2 4"
+        strokeLinecap="round"
+      />
+      <text
+        fontFamily="var(--font-geist-mono), ui-monospace, monospace"
+        fontWeight="700"
+        fontSize="10.4"
+        letterSpacing="2.4"
+        fill="var(--ink, #191a2e)"
+      >
+        <textPath href={`#${id}`} startOffset="0" textLength="226">
+          {ring.toUpperCase()}
+        </textPath>
+      </text>
+      <path
+        transform="translate(45 45) scale(0.75)"
+        d="M20 2C21 14 26 19 38 20C26 21 21 26 20 38C19 26 14 21 2 20C14 19 19 14 20 2Z"
+        fill="var(--ink, #191a2e)"
+      />
+    </svg>
+  )
+}
diff --git a/features/landing-page/studio/gravity/sticker-pit.module.css b/features/landing-page/studio/gravity/sticker-pit.module.css
new file mode 100644
index 0000000..6b254c4
--- /dev/null
+++ b/features/landing-page/studio/gravity/sticker-pit.module.css
@@ -0,0 +1,151 @@
+/* The About tray: a release liner the stickers fall onto. Paper Lo ground, ink
+   edge, one hard offset shadow, like every other Sunnyside surface. */
+
+.wrap {
+  position: relative;
+  z-index: 2;
+  margin-top: clamp(2.2rem, 5vw, 3.4rem);
+}
+
+.pit {
+  position: relative;
+  height: clamp(13.5rem, 25vw, 17.5rem);
+  border: 2px solid var(--ink);
+  border-radius: 20px;
+  background-color: var(--paper-lo);
+  background-image: radial-gradient(rgb(25 26 46 / 0.16) 1px, transparent 1px);
+  background-size: 16px 16px;
+  box-shadow: 7px 8px 0 rgb(25 26 46 / 0.14);
+  /* Stickers fall in from above the tray, so it must not clip them. */
+  overflow: visible;
+}
+
+.label {
+  position: absolute;
+  top: 0.8rem;
+  left: 1rem;
+  font-family: var(--font-geist-mono), monospace;
+  font-size: 9px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.ghosts i {
+  position: absolute;
+  left: var(--x);
+  top: var(--y);
+  width: calc(var(--size) * 0.92);
+  aspect-ratio: 1;
+  border: 1.5px dashed rgb(25 26 46 / 0.28);
+  border-radius: 50%;
+  transform: translate(-50%, -50%) rotate(var(--rot));
+}
+
+/* At rest and in reduced motion: the sticker sits in its own outline. The
+   runtime switches the tray to `data-live`, which hands position to the
+   physics and hides each sticker until it is released. */
+.sticker {
+  position: absolute;
+  z-index: 3;
+  left: var(--x);
+  top: var(--y);
+  width: var(--size);
+  height: var(--size);
+  transform: translate(-50%, -50%) rotate(var(--rot));
+  /* The same low sun lights every sticker: a warm rim upper-left and a hard
+     ink shadow lower-right, both offsets rather than blurs. */
+  filter: drop-shadow(3px 5px 0 rgb(25 26 46 / 0.2))
+    drop-shadow(-1.5px -1.5px 0 rgb(255 210 63 / 0.34));
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.sticker svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+.pit[data-live='true'] .sticker {
+  left: 0;
+  top: 0;
+  visibility: hidden;
+  cursor: grab;
+  /* Only the stickers take the touch, so the rest of the tray still scrolls. */
+  touch-action: none;
+  will-change: transform;
+}
+
+.pit[data-live='true'] .sticker[data-held='true'] {
+  cursor: grabbing;
+  filter: drop-shadow(6px 10px 0 rgb(25 26 46 / 0.22))
+    drop-shadow(-1.5px -1.5px 0 rgb(255 210 63 / 0.34));
+}
+
+.atomDisc {
+  display: grid;
+  place-items: center;
+  width: 100%;
+  height: 100%;
+  border: 8px solid var(--paper-hi);
+  border-radius: 50%;
+  background: var(--cobalt);
+  color: var(--paper-hi);
+}
+
+.atomDisc svg {
+  width: 82%;
+  height: 82%;
+}
+
+.foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  margin-top: 1.1rem;
+}
+
+.hint {
+  font-family: var(--font-geist-mono), monospace;
+  font-size: 10px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.shake {
+  min-height: 2.5rem;
+  padding: 0.5rem 1rem;
+  border: 1.5px solid var(--ink);
+  border-radius: 999px;
+  background: var(--butter);
+  color: var(--ink);
+  font-size: 0.82rem;
+  font-weight: 600;
+  box-shadow: 3px 3px 0 var(--ink);
+  transition:
+    transform 0.18s var(--ease-out),
+    box-shadow 0.18s var(--ease-out);
+}
+
+.shake:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 4px 4px 0 var(--ink);
+}
+
+.shake:active {
+  transform: translate(2px, 2px);
+  box-shadow: 1px 1px 0 var(--ink);
+}
+
+@media (max-width: 640px) {
+  .hint {
+    display: none;
+  }
+
+  .foot {
+    justify-content: flex-end;
+  }
+}
diff --git a/features/landing-page/studio/gravity/sticker-pit.tsx b/features/landing-page/studio/gravity/sticker-pit.tsx
new file mode 100644
index 0000000..bfa3209
--- /dev/null
+++ b/features/landing-page/studio/gravity/sticker-pit.tsx
@@ -0,0 +1,123 @@
+'use client'
+
+import { useReducedMotion } from 'motion/react'
+import { useEffect, useRef, type CSSProperties } from 'react'
+
+import { Bolt, Burst, Daisy, Atom, Smiley } from '../doodles'
+import { PIT_STICKERS, type PitSpec } from './pit-config'
+import { runPit, type PitRuntime } from './pit-runtime'
+import { Stamp } from './stamps'
+import styles from './sticker-pit.module.css'
+
+function Art({ spec }: { spec: PitSpec }) {
+  switch (spec.id) {
+    case 'smiley':
+      return <Smiley />
+    case 'burst':
+      return <Burst text="wow!" />
+    case 'daisy':
+      return <Daisy />
+    case 'bolt':
+      return <Bolt />
+    case 'atom':
+      return (
+        <span className={styles.atomDisc}>
+          <Atom />
+        </span>
+      )
+    case 'stampCity':
+      return <Stamp text="Jakarta · GMT+7" fill="var(--mint)" />
+    case 'stampRole':
+      return <Stamp text="Design engineer" fill="var(--butter)" />
+  }
+}
+
+/**
+ * The release liner: the backing sheet the stickers were peeled from.
+ *
+ * When it scrolls into view the stickers drop in from above under gravity,
+ * pile up, and can be picked up and flung. The faint dashed outlines are the
+ * shapes they left behind, and they are also where the stickers sit when
+ * motion is reduced, so the tray is complete without the physics.
+ *
+ * Everything inside is decoration. The one control, "Shake the tray", is a
+ * real button so the toy has a keyboard and screen-reader path, and the
+ * stickers themselves are hidden from assistive tech.
+ */
+export function StickerPit() {
+  const reduced = useReducedMotion() ?? false
+  const pitRef = useRef<HTMLDivElement>(null)
+  const runtime = useRef<PitRuntime | null>(null)
+
+  useEffect(() => {
+    if (reduced || !pitRef.current) return
+    const pit = pitRef.current
+    pit.dataset.live = 'true'
+    runtime.current = runPit(pit)
+    return () => {
+      runtime.current?.stop()
+      runtime.current = null
+      delete pit.dataset.live
+    }
+  }, [reduced])
+
+  return (
+    <div className={styles.wrap}>
+      <div ref={pitRef} className={styles.pit} data-gravity-pit>
+        <div className={styles.ghosts} aria-hidden>
+          {PIT_STICKERS.map((spec) => (
+            <i
+              key={spec.id}
+              style={
+                {
+                  '--x': `${spec.rest.x * 100}%`,
+                  '--y': `${spec.rest.y * 100}%`,
+                  '--size': `${spec.size}px`,
+                  '--rot': `${spec.rest.rot}deg`,
+                } as CSSProperties
+              }
+            />
+          ))}
+        </div>
+
+        <span className={styles.label} aria-hidden>
+          release liner · {PIT_STICKERS.length} stickers
+        </span>
+
+        {PIT_STICKERS.map((spec) => (
+          <div
+            key={spec.id}
+            className={styles.sticker}
+            data-pit-sticker={spec.id}
+            aria-hidden
+            style={
+              {
+                '--x': `${spec.rest.x * 100}%`,
+                '--y': `${spec.rest.y * 100}%`,
+                '--size': `${spec.size}px`,
+                '--rot': `${spec.rest.rot}deg`,
+              } as CSSProperties
+            }
+          >
+            <Art spec={spec} />
+          </div>
+        ))}
+      </div>
+
+      <div className={styles.foot}>
+        <span className={styles.hint} aria-hidden>
+          pick one up, throw it
+        </span>
+        {reduced ? null : (
+          <button
+            type="button"
+            className={styles.shake}
+            onClick={() => runtime.current?.shake()}
+          >
+            Shake the tray
+          </button>
+        )}
+      </div>
+    </div>
+  )
+}
