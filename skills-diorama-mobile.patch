+/* ── Phones: one framed card per station, stacked ──────────────────────── */
+
+@media (max-width: 860px) {
+  .room {
+    --stage-w: min(calc(100vw - 2rem), 34rem);
+    display: block;
+    padding-inline: 1rem;
+  }
+
+  .stageWrap {
+    width: 100%;
+    max-width: 34rem;
+    margin-inline: auto;
+    padding-top: 0;
+  }
+
+  .stage {
+    --tz: 1.5;
+    aspect-ratio: auto;
+  }
+
+  .stage::before,
+  .scene::after,
+  .wall,
+  .front {
+    display: none;
+  }
+
+  .scene {
+    position: static;
+    display: flex;
+    flex-direction: column;
+    gap: 1.5rem;
+    overflow: visible;
+  }
+
+  /* the controller stops floating over a frame and sticks under the header */
+  .controller {
+    position: sticky;
+    top: 4.5rem;
+    left: auto;
+    translate: none;
+    width: 100%;
+    margin-bottom: 1.25rem;
+    padding: 0.75rem 0.85rem 0.85rem;
+    border-radius: 0.9rem;
+  }
+
+  .controllerTop {
+    gap: 0.7rem;
+    margin-bottom: 0.6rem;
+    font-size: 0.9rem;
+  }
+
+  .kinetic {
+    width: 2.4rem;
+    height: 1.3rem;
+  }
+
+  .knob {
+    width: 0.9rem;
+    height: 0.9rem;
+    left: calc(100% - 1.15rem);
+  }
+
+  .kinetic[aria-pressed='false'] .knob {
+    left: 0.25rem;
+  }
+
+  .pills {
+    flex-wrap: wrap;
+    gap: 0.4rem;
+  }
+
+  .pill {
+    padding: 0.38rem 0.75rem;
+    font-size: 0.78rem;
+  }
+
+  .card[data-id='build'] {
+    order: 1;
+  }
+  .card[data-id='motion'] {
+    order: 2;
+  }
+  .card[data-id='systems'] {
+    order: 3;
+  }
+  .card[data-id='rest'] {
+    order: 4;
+  }
+
+  /* on a phone the controller chooses a card, it does not dim the others */
+  .stage[data-station='build'] .card:not([data-id='build']),
+  .stage[data-station='motion'] .card:not([data-id='motion']),
+  .stage[data-station='systems'] .card:not([data-id='systems']),
+  .stage[data-station='rest'] .card:not([data-id='rest']) {
+    display: none;
+  }
+
+  .card {
+    --card-w: min(calc(100vw - 2rem), 34rem);
+    --frame: 0.45rem;
+    --u: calc((var(--card-w) - var(--frame) * 2) / var(--pw));
+
+    display: block;
+    position: relative;
+    width: 100%;
+    overflow: hidden;
+    border-radius: 0.9rem;
+    background: #1f1f2c;
+    box-shadow:
+      0 0 0 1px #6b4b2e,
+      0 0.9rem 1.6rem rgb(0 0 0 / 0.45);
+  }
+
+  /* the window: a wooden frame round the crop of the scene */
+  .view {
+    display: block;
+    position: relative;
+    box-sizing: content-box;
+    width: calc(100% - var(--frame) * 2);
+    aspect-ratio: calc(var(--pw) / var(--ph));
+    overflow: hidden;
+    border: var(--frame) solid #b08c66;
+    border-bottom: 0;
+    border-radius: 0.9rem 0.9rem 0 0;
+    background: radial-gradient(ellipse at 50% 55%, #5b3e27, #2c1a0e);
+    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
+  }
+
+  .layer,
+  .layer[data-id] {
+    position: absolute;
+    inset: auto;
+    left: calc(var(--ox) * var(--u) * -1);
+    top: calc(var(--oy) * var(--u) * -1);
+    width: calc(813 * var(--u));
+    height: calc(467 * var(--u));
+    translate: none;
+    scale: none;
+    filter: none;
+    opacity: 1;
+    transform: none;
+  }
+
+  /* the art is decoration here; the real controls are underneath */
+  .layer :is(button, input) {
+    pointer-events: none;
+  }
+
+  .deskLine {
+    display: none;
+  }
+
+  .below {
+    display: block;
+    padding: 1rem 1rem 1.25rem;
+    background: #1f1f2c;
+    color: #f3ecdf;
+    border-top: 3px solid #b08c66;
+  }
+
+  .belowLine {
+    margin: 0 0 0.9rem;
+    font-family: var(--font-geist), system-ui, sans-serif;
+    font-size: 0.95rem;
+    line-height: 1.5;
+    color: rgb(243 236 223 / 0.84);
+  }
+
+  .belowNote {
+    margin: 0.9rem 0 0;
+    font-family: var(--font-geist-mono), ui-monospace, monospace;
+    font-size: 0.78rem;
+    color: rgb(243 236 223 / 0.7);
+  }
+
+  .belowNote strong {
+    color: #f2c23a;
+    font-weight: 600;
+  }
+
+  .chips {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+    margin: 0 0 0.9rem;
+    padding: 0;
+    list-style: none;
+  }
+
+  .chips:last-child {
+    margin-bottom: 0;
+  }
+
+  .chips li,
+  .chipBtn {
+    display: inline-flex;
+    align-items: center;
+    min-height: 2.25rem;
+    padding: 0 0.8rem;
+    border: 1.5px solid #2b2118;
+    border-radius: 0.55rem;
+    background: #ece6d6;
+    color: #1a1a2b;
+    font-family: var(--font-geist-mono), ui-monospace, monospace;
+    font-size: 0.82rem;
+    font-weight: 600;
+    box-shadow: 2px 3px 0 rgb(0 0 0 / 0.5);
+  }
+
+  .chips li:nth-child(4n + 1) {
+    background: #f5d03e;
+  }
+  .chips li:nth-child(4n + 2) {
+    background: #8ec1ea;
+  }
+  .chips li:nth-child(4n + 3) {
+    background: #d9e7ec;
+  }
+  .chips li:nth-child(4n) {
+    background: #86c46e;
+  }
+  .chips li[data-hot] {
+    background: #f2c23a;
+  }
+
+  .chips li:has(.chipBtn) {
+    padding: 0;
+    background: none;
+    border: 0;
+    box-shadow: none;
+  }
+
+  .chipBtn {
+    min-height: 2.5rem;
+    cursor: pointer;
+  }
+
+  .chipBtn[aria-pressed='true'] {
+    background: #ee6f9a;
+  }
+
+  .mWeather {
+    margin-top: 1rem;
+    padding: 0.9rem 0.9rem 1rem;
+    border: 1.5px solid #6a5320;
+    border-radius: 0.7rem;
+    background: #f7de8c;
+    color: #3f3210;
+  }
+
+  .mWeather h4 {
+    margin: 0 0 0.6rem;
+    font-family: var(--font-geist-mono), ui-monospace, monospace;
+    font-size: 0.72rem;
+    font-weight: 600;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+  }
+
+  .mCurve {
+    display: grid;
+    grid-template-columns: 4.6rem 1fr 3.4rem;
+    align-items: center;
+    gap: 0.6rem;
+    min-height: 2.75rem;
+    font-family: var(--font-geist-mono), ui-monospace, monospace;
+    font-size: 0.78rem;
+    font-weight: 600;
+    text-transform: uppercase;
+  }
+
+  .mCurve span {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.35rem;
+  }
+
+  .mCurve i {
+    width: 0.7rem;
+    height: 0.7rem;
+    border: 1.5px solid #2b2118;
+    border-radius: 50%;
+  }
+
+  .mCurve input {
+    width: 100%;
+    height: 2.4rem;
+    margin: 0;
+    accent-color: #ee6f5a;
+  }
+
+  .mCurve output {
+    text-align: right;
+    font-size: 0.7rem;
+    color: #6a5320;
+  }
+
+  .mPlay,
+  .mBtn {
+    min-height: 2.9rem;
+    border: 2px solid #2b2118;
+    border-radius: 999px;
+    background: #f6e7a8;
+    color: #2b2118;
+    font-family: var(--font-geist-mono), ui-monospace, monospace;
+    font-size: 0.8rem;
+    font-weight: 600;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    box-shadow: 0 3px 0 #b99a45;
+    cursor: pointer;
+  }
+
+  .mPlay {
+    width: 100%;
+    margin-top: 0.7rem;
+  }
+
+  .mPlay:active,
+  .mBtn:active {
+    transform: translateY(2px);
+    box-shadow: 0 1px 0 #b99a45;
+  }
+
+  .mConsole {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0.7rem;
+    margin-bottom: 0.9rem;
+  }
+
+  .mBtn {
+    background: #f2ecdc;
+    box-shadow: 0 3px 0 #8f8873;
+  }
+
+  .mBtn[aria-pressed='true'] {
+    background: #dff3e4;
+    box-shadow: 0 3px 0 #3c9d6b;
+  }
+
+  .mPlay:focus-visible,
+  .mBtn:focus-visible,
+  .chipBtn:focus-visible,
+  .mCurve input:focus-visible {
+    outline: 2px solid #3d53d6;
+    outline-offset: 2px;
+  }
+
+  .note {
+    flex-direction: column;
+    gap: 0.4rem;
+    margin-inline: 0;
+  }
+}
