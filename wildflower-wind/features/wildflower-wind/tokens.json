{
  "meta": {
    "name": "Wildflower Wind",
    "slug": "wildflower-wind",
    "namespace": "--wi-",
    "version": "2.0.0",
    "year": 2026,
    "author": "Sunnyside",
    "archetype": "minimal",
    "primaryAccent": "signal",
    "essence": "A meadow, seen through a pane of glass.",
    "promise": "Everything you make with this looks gathered, not arranged.",
    "family": "One glass petal, four times held, one time gone.",
    "track": "constructed",
    "oneSentence": "Wildflower Wind is a seed house seen through glass: a haze ground, translucent panes with one lit edge, a violet that is the cosmos refracted, and a mark built from five petals where the overlap is the ink.",
    "gate": "v3.6",
    "contrastPairs": 15,
    "failingPairs": 2
  },
  "theme": {
    "family": "constructed — a placement table, rendered in glass",
    "material": "frosted glass over a meadow; one lit edge per surface",
    "edge": "1px of light on the top-left, nothing on the bottom-right",
    "offset": "the taken petal sits 2.6 petal-lengths out, never closer",
    "stroke": "no strokes — the rim is a highlight, not a line",
    "tile": "rounded, never square; a glass chip is a lens, not a box",
    "radius": "6 / 12 / 20 / 28 / 40 — nested, inner = outer − padding",
    "ring": "signal at 2px, 2px offset, plus a 1px white inner rim",
    "density": "airy: 104px section rhythm, 24px paragraph rhythm",
    "label": "uppercase mono, 0.16em, always above the thing it names",
    "field-recipe": "photograph, blurred and tinted, then a pane on top",
    "mark-form": "five translucent petals; overlap multiplies to ink"
  },
  "sections": [
    "field",
    "premise",
    "calyx",
    "light",
    "setting",
    "kit",
    "season",
    "sheet",
    "ledger"
