+/* The hero: a pop-up paper theatre.
+
+   Two halves. `.scene` is the stage: depth planes inside a `preserve-3d` box
+   that the pointer tilts (see theater-scene.tsx). `.front` is everything you
+   read and press: two cardboard signs, the paper bio card, the pull-tab.
+
+   Colour is the site's own palette (cobalt, tangerine, butter, paper, ink) and
+   cardboard is the one new material. Shadows are hard and directional, like the
+   rest of the page; the only soft ones are under whole planes, where they stand
+   for distance. */
+
+.hero {
+  --card: #c9a574;
+  --card-lo: #a88252;
+  --card-hi: #dcbe91;
+
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  min-height: max(100svh, 40rem);
+  overflow: clip;
+  background: var(--cobalt-ink);
+  color: var(--paper-hi);
+}
+
+.hero :focus-visible {
+  outline: 3px solid var(--butter);
+  outline-offset: 3px;
+}
+
+/* ── The stage ─────────────────────────────────────────────────────────── */
+
+.scene {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  overflow: hidden;
+  perspective: 1500px;
+  perspective-origin: 50% 38%;
+  pointer-events: none;
+}
+
+.stage3d {
+  position: absolute;
+  inset: 0;
+  transform-style: preserve-3d;
+  transform: scale(1.05);
+  will-change: transform;
+  /* opacity only: the pointer writes `transform`, and an animation on it would
+     keep overriding that for good */
+  animation: stage-in 1.2s var(--ease-out) backwards;
+}
+
+/* One layer of the stage. `--z` is its distance, `--k` cancels the perspective
+   so it looks flat until the stage tilts and reveals the gap. */
+.plane {
+  position: absolute;
+  inset: 0;
+  transform: translateZ(var(--z, 0px)) scale(var(--k, 1));
+}
+
+.plane svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+
+.plane[data-shadow] svg {
+  filter: drop-shadow(0 0.9rem 1.2rem rgb(8 12 50 / 0.42));
+}
+
+.cloud {
+  animation: drift 14s ease-in-out infinite alternate;
+  animation-delay: var(--d, 0s);
+}
+
+/* ── Gears, with brass brads for hubs ──────────────────────────────────── */
+
+.gearSlot {
+  position: absolute;
+  aspect-ratio: 1;
+  translate: -50% -50%;
+  transform: translateZ(var(--z, 0px)) scale(var(--k, 1));
+}
+
+.gear {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  filter: drop-shadow(0 0.5rem 0.7rem rgb(8 12 50 / 0.4));
+}
+
+.gearSvg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  animation: spin 90s linear infinite;
+}
+
+.gear .brad {
+  top: 50%;
+  left: 50%;
+  translate: -50% -50%;
+}
+
+.brad {
+  position: absolute;
+  width: 0.72rem;
+  height: 0.72rem;
+  border: 1.5px solid #5a3d08;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 30%, #fff1b8, #e0a92a 55%, #8a5e0f);
+  box-shadow: 0.08rem 0.14rem 0 rgb(0 0 0 / 0.35);
+}
+
+.brad[data-corner='tl'] {
+  top: 0.45rem;
+  left: 0.45rem;
+}
+.brad[data-corner='tr'] {
+  top: 0.45rem;
+  right: 0.45rem;
+}
+.brad[data-corner='bl'] {
+  bottom: 0.45rem;
+  left: 0.45rem;
+}
+.brad[data-corner='br'] {
+  right: 0.45rem;
+  bottom: 0.45rem;
+}
+
+/* ── The sun, now just a prop on a string ──────────────────────────────── */
+
+.sunSlot {
+  position: absolute;
+  top: -2px;
+  right: 7%;
+  width: clamp(4.4rem, 8.4vw, 7.6rem);
+}
+
+.sunSwing {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  transform-origin: 50% 0;
+  animation: swing 5.5s ease-in-out infinite alternate;
+}
+
+.string {
