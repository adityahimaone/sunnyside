+
+function Letter({
+  char,
+  index,
+  pull,
+  tone,
+}: {
+  char: string
+  index: number
+  pull: MotionValue<number>
+  tone: 'cream' | 'butter'
+}) {
+  const dir = index % 2 ? 1 : -1
+  const z = useTransform(pull, [0, 1], [0, 26 + (index % 3) * 9])
