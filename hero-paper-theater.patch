+/** Bleed, so a tilting stage never shows its own edge. */
+const BLEED = 1
+
+const kFor = (z: number) => ((EYE - z) / EYE) * BLEED
+
+const planeVars = (z: number) =>
+  ({ '--z': `${z}px`, '--k': String(kFor(z)) }) as CSSProperties
+
+const FRAME = 'M-200 -200H1800V1100H-200Z'
