+ */
+function Letters({
+  text,
+  pull,
+  tone,
+}: {
+  text: string
+  pull: MotionValue<number>
+  tone: 'cream' | 'butter'
+}) {
+  return (
+    <span className={styles.letters} aria-hidden>
+      {Array.from(text).map((char, i) => (
+        <Letter
+          key={`${char}-${i}`}
