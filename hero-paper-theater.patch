+}
+
+.lede strong {
+  font-weight: 700;
+  background: linear-gradient(transparent 62%, var(--butter) 62%);
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.6rem 1.1rem;
+  margin-top: 1rem;
+}
+
+.cta,
+.link {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  font-family: var(--font-geist), system-ui, sans-serif;
+  font-size: 0.86rem;
+  font-weight: 600;
+  cursor: pointer;
+}
+
+.cta {
+  padding: 0.62rem 1.05rem;
+  border: 2px solid var(--ink);
+  border-radius: 999px;
+  background: var(--butter);
+  box-shadow: 0.2rem 0.25rem 0 var(--ink);
+  color: var(--ink);
+  transition:
+    transform 0.2s var(--ease-spring),
+    box-shadow 0.2s var(--ease-spring);
+}
+
+.cta:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 0.3rem 0.35rem 0 var(--ink);
+}
+
+.cta:active {
+  transform: translate(2px, 2px);
+  box-shadow: 0.05rem 0.08rem 0 var(--ink);
+}
+
+.link {
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--ink);
+  text-decoration: underline;
+  text-decoration-color: var(--tangerine);
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.25em;
+}
+
+.facts {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 0.6rem;
+  margin: 1rem 0 0;
+  padding-top: 0.8rem;
+  border-top: 2px dashed rgb(25 26 46 / 0.3);
+}
+
+.fact dd {
+  display: flex;
+  flex-direction: column;
+  gap: 0.15rem;
+  margin: 0;
+}
+
+.fact b {
+  font-family: var(--font-syne), system-ui, sans-serif;
+  font-size: 1.3rem;
+  font-weight: 800;
+  line-height: 1;
+  letter-spacing: -0.03em;
+}
+
+.fact span {
+  font-family: var(--font-geist-mono), ui-monospace, monospace;
+  font-size: 0.55rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: #4a4760;
+}
+
+/* ── Boot: the page's intro holds the stage still until it is done ──────── */
+
+:global(html[data-boot='on']) .scene *,
+:global(html[data-boot='on']) .scene *::before,
+:global(html[data-boot='on']) .planks * {
+  animation-play-state: paused !important;
+}
+
+/* ── Smaller than a laptop ─────────────────────────────────────────────── */
+
+@media (max-width: 1199px) {
+  .signB {
+    left: 50%;
+  }
+
+  .arm {
+    width: clamp(1.6rem, 4vw, 3.5rem);
+  }
+}
+
+/* ── Phones and tablets: the signs stack and the card sits under them ───── */
+
+@media (max-width: 899px) {
+  .hero {
+    min-height: auto;
+    padding-top: 5.4rem;
+  }
+
+  .item {
+    top: var(--tys);
+    left: var(--lxs);
+  }
+
+  .front {
+    position: relative;
+    inset: auto;
+    display: flex;
+    flex-direction: column;
+    gap: 2.6rem;
+    padding: 2.6rem 1rem 3.2rem;
+    pointer-events: auto;
+  }
+
+  .planks {
+    position: relative;
+    inset: auto;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 2.6rem;
+  }
+
+  .signA,
+  .signB {
+    position: relative;
+    top: auto;
+    left: auto;
+    translate: none;
+    max-width: 100%;
+  }
+
+  .signA {
+    font-size: clamp(1.1rem, 7.4vw, 3rem);
+  }
+
+  .signB {
+    font-size: clamp(1.7rem, 12vw, 4.4rem);
+    margin-bottom: 1.4rem;
+  }
+
+  .arm {
+    display: none;
+  }
+
+  .pullTab {
+    left: 50%;
+    translate: -50% 0;
+  }
+
+  .card {
+    position: relative;
+    bottom: auto;
+    left: auto;
+    width: min(100%, 30rem);
+    margin-inline: auto;
+  }
+}
+
+@media (max-width: 479px) {
+  .sunSlot {
+    right: 4%;
+    width: 3.6rem;
+  }
+
+  .sticker {
+    width: 2.7rem;
+  }
+}
+
+/* ── Motion ────────────────────────────────────────────────────────────── */
+
+@keyframes stage-in {
+  from {
+    opacity: 0;
+  }
+}
+
+@keyframes sign-drop {
+  from {
+    opacity: 0;
+    transform: translateY(-3.5rem) rotate(-4deg);
+  }
+}
+
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@keyframes drift {
+  from {
+    transform: translateX(calc(var(--dx, 12px) * -1));
+  }
+  to {
+    transform: translateX(var(--dx, 12px));
+  }
+}
+
+@keyframes swing {
+  from {
+    transform: rotate(-5deg);
+  }
+  to {
+    transform: rotate(5deg);
+  }
+}
+
+@keyframes sticker-pop {
+  from {
+    transform: scale(0.2) rotate(-24deg);
+    opacity: 0;
+  }
+}
+
+@keyframes bob {
+  to {
+    transform: translateY(-9px) rotate(2.5deg);
+  }
+}
+
+@keyframes twinkle {
+  0%,
+  100% {
+    transform: scale(0.75) rotate(0deg);
+    opacity: 0.55;
+  }
+  50% {
+    transform: scale(1.15) rotate(18deg);
+    opacity: 1;
+  }
+}
+
+/* Reduced motion keeps the whole picture and the pull itself, which the
+   visitor drives; it removes everything that moves on its own. */
+@media (prefers-reduced-motion: reduce) {
+  .stage3d,
+  .signA,
+  .signB,
+  .sticker,
+  .float,
+  .sparkle,
+  .gearSvg,
+  .cloud,
+  .sunSwing {
+    animation: none;
+  }
+}
