+/* ── Desktop: a pop-up book that opens as you scroll ───────────────────── */
+
+.book {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 813 / 467;
+}
+
+.leaf,
+.layerBase,
+.shade {
+  position: absolute;
+}
+
+.layerBase {
+  inset: 0;
+}
+
+.leaf {
+  /* the spine is the vertical middle of the spread; the leaf is its right half */
+  top: 0;
+  left: 50%;
+  width: 50%;
+  height: 100%;
+  transform-origin: 0 50%;
+  transform-style: preserve-3d;
+  transform: rotateY(calc(var(--open, 1) * -180deg));
+}
+
+.leafFace {
+  position: absolute;
+  inset: 0;
+  backface-visibility: hidden;
+  -webkit-backface-visibility: hidden;
+}
+
+.leafBack {
+  transform: rotateY(180deg);
+}
+
+/* the turning cover shades itself as it passes edge-on */
+.leafFace::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: rgb(8 12 40 / calc(var(--hump, 0) * 0.4));
+}
+
+/* and throws a shadow across the page it is leaving */
+.shade {
+  top: 0;
+  left: 50%;
+  width: 50%;
+  height: 100%;
+  pointer-events: none;
+  background: linear-gradient(
+    90deg,
+    rgb(20 14 6 / calc(var(--hump, 0) * 0.5)),
+    transparent 75%
+  );
+}
+
+.coverKicker,
+.coverTitle,
+.coverSub {
+  position: absolute;
+  margin: 0;
+  white-space: nowrap;
+}
+
+.coverKicker {
+  font-family: var(--font-geist-mono), ui-monospace, monospace;
+  font-weight: 600;
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+  color: #f2c23a;
+}
+
+.coverTitle {
+  font-family: var(--font-syne), system-ui, sans-serif;
+  font-weight: 800;
+  line-height: 0.98;
+  letter-spacing: -0.04em;
+  color: #f4eedf;
+  text-shadow:
+    0 calc(var(--u) * 1.2) 0 #1c2872,
+    calc(var(--u) * 1.4) calc(var(--u) * 2.6) calc(var(--u) * 3)
+      rgb(0 0 0 / 0.5);
+}
+
+.coverSub {
+  font-family: var(--font-geist-mono), ui-monospace, monospace;
+  font-weight: 500;
+  line-height: 1.5;
+  letter-spacing: 0.06em;
+  color: rgb(244 238 223 / 0.82);
+}
+
+.coverSun {
+  position: absolute;
+  right: 11%;
+  bottom: 9%;
+  width: 36%;
+  height: auto;
+  filter: drop-shadow(0 calc(var(--u) * 3) calc(var(--u) * 3) rgb(0 0 0 / 0.4));
+  animation: spin 70s linear infinite;
+}
+
+.coverSpark {
+  position: absolute;
+  top: 17%;
+  right: 17%;
+  width: 7%;
+  color: #f2c23a;
+  animation: twinkleHtml 3s ease-in-out infinite;
+}
+
+.coverDaisy {
+  position: absolute;
+  left: 11%;
+  bottom: 10%;
+  width: 17%;
+  filter: drop-shadow(0 calc(var(--u) * 2) calc(var(--u) * 2) rgb(0 0 0 / 0.4));
+}
+
+.coverCue {
+  position: absolute;
+  display: inline-flex;
+  align-items: center;
+  gap: calc(var(--u) * 5);
+  margin: 0;
+  padding: calc(var(--u) * 4) calc(var(--u) * 10);
+  border: calc(var(--u) * 1) solid #f2c23a;
+  border-radius: 999px;
+  font-family: var(--font-geist-mono), ui-monospace, monospace;
+  font-weight: 600;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  white-space: nowrap;
+  color: #f2c23a;
+}
+
+.coverCue span {
+  display: inline-block;
+  animation: cueBob 1.6s ease-in-out infinite;
+}
+
+@keyframes twinkleHtml {
+  0%,
+  100% {
+    opacity: 0.6;
+    transform: scale(0.85) rotate(0deg);
+  }
+  50% {
+    opacity: 1;
+    transform: scale(1.15) rotate(20deg);
+  }
+}
+
+@keyframes cueBob {
+  0%,
+  100% {
+    transform: translateY(0);
+  }
+  50% {
+    transform: translateY(5px);
+  }
+}
+
+/* The controller is for the phone layout; the book has no station filter. */
+@media (min-width: 861px) {
+  .controller {
+    display: none;
+  }
+
+  .room {
+    --stage-w: min(95rem, calc(100vw - 2rem), calc((100vh - 6.5rem) * 1.741));
+  }
+
+  /* panels fold up off the page about their own base edge */
+  .layer[data-id] {
+    --pop: 1;
+    --base: 64%;
+    transform-origin: 50% var(--base);
+    transform: rotateX(calc((1 - var(--pop)) * 86deg));
+    opacity: clamp(0, calc(var(--pop) * 4), 1);
+    will-change: transform, opacity;
+  }
+
+  .layer[data-id='build'] {
+    --pop: var(--pop-build, 1);
+    --base: 64.2%;
+  }
+  .layer[data-id='motion'] {
+    --pop: var(--pop-motion, 1);
+    --base: 64%;
+  }
+  .layer[data-id='rest'] {
+    --pop: var(--pop-rest, 1);
+    --base: 95.3%;
+  }
+  .layer[data-id='systems'] {
+    --pop: var(--pop-systems, 1);
+    --base: 96.8%;
+  }
+
+  .scene {
+    perspective: 1900px;
+    perspective-origin: 50% 18%;
+  }
+
+  .stageWrap {
+    perspective: 2400px;
+    perspective-origin: 50% 40%;
+  }
+}
+
+/* Motion allowed: the section becomes a tall rail with a sticky stage, and
+   the book starts shut. The script writes --open and --pop-* as you scroll. */
+@media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
+  .rail {
+    position: relative;
+    height: 340vh;
+  }
+
+  .pinned {
+    position: sticky;
+    top: 0;
+    display: grid;
+    place-items: center;
+    height: 100vh;
+    padding-top: 3.5rem;
+  }
+
+  .room {
+    margin-top: 0;
+  }
+
+  .stage {
+    --open: 0;
+    --hump: 0;
+    --pop-build: 0;
+    --pop-motion: 0;
+    --pop-rest: 0;
+    --pop-systems: 0;
+  }
+
+  .book {
+    /* shut: centred on its own half, tilted toward you; open: flat and centred */
+    translate: calc((1 - var(--open)) * var(--stage-w) * -0.25) 0;
+    scale: calc(1 + (1 - var(--open)) * 0.1);
+    transform: rotateX(calc((1 - var(--open)) * 14deg))
+      rotateY(calc((1 - var(--open)) * -12deg));
+    transform-origin: 50% 60%;
+    will-change: transform, translate, scale;
+  }
+
+  /* shut or half-open, the panels are not there to be used */
+  .stage:not([data-book-open='true'])
+    .layer
+    :is(button, input, a, .tag, .drawerTools li, .ribbons li, .windTags li) {
+    pointer-events: none;
+  }
+}
+
+/* Reduced motion, desktop: no rail, no turning: the book is simply open. */
+@media (min-width: 861px) and (prefers-reduced-motion: reduce) {
+  .shade {
+    display: none;
+  }
+}
